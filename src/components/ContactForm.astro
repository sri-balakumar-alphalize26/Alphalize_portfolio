---
import { localeHref } from '@/i18n/paths';
import Field from './Field.astro';
import PhoneField from './PhoneField.astro';
import Icon from './Icon.astro';

import { parts } from '@/i18n/messages';

const { locale, t } = Astro.locals;
/** Prefix an internal path with this page's locale. */
const loc = (to: string) => localeHref(locale, to);

/* The privacy sentence carries an inline link, so it is one string split on
   <0>…</0> rather than three keys a translator cannot reorder. */
const [privacyBefore, privacyLink, privacyAfter] = parts(t('contactForm.privacyNote'));
---

{
  /* No action and no data-enhance: submitting composes a WhatsApp message and
    opens it, exactly as the 369 enquiry form does. Nothing is posted, so the
    enquiry only reaches us once the visitor presses send in WhatsApp. */
}
<form class="rounded-card border-brand-100 border bg-white p-6 sm:p-8">
  <h2 class="text-ink text-xl font-semibold">{t('contactForm.heading')}</h2>
  <p class="text-muted mt-1.5 text-sm">
    {t('contactForm.intro')}
  </p>

  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <Field
      name="name"
      label={t('contactForm.nameLabel')}
      required
      autocomplete="name"
      placeholder={t('contactForm.namePlaceholder')}
    />
    <Field
      name="email"
      label={t('contactForm.emailLabel')}
      type="email"
      required
      autocomplete="email"
      placeholder={t('contactForm.emailPlaceholder')}
    />
    <PhoneField
      name="phone"
      label={t('contactForm.phoneLabel')}
      required
      placeholder={t('contactForm.phonePlaceholder')}
    />
    <Field
      name="subject"
      label={t('contactForm.subjectLabel')}
      required
      placeholder={t('contactForm.subjectPlaceholder')}
    />
    <Field
      name="message"
      label={t('contactForm.messageLabel')}
      type="textarea"
      required
      class="sm:col-span-2"
      placeholder={t('contactForm.messagePlaceholder')}
    />
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button type="submit" data-wa-send class="btn btn-primary w-full sm:w-auto">
      {t('contactForm.submit')}
      <Icon name="whatsapp" class="size-4" />
    </button>

    {
      /* WhatsApp opens in a new tab; if a popup blocker ate it, say so rather
        than leaving the visitor wondering whether anything happened. */
    }
    <p class="text-muted text-sm" role="status" aria-live="polite" data-wa-hint></p>
  </div>

  <p class="text-muted mt-3 text-xs">
    {t('contactForm.whatsappNote')}
  </p>

  <noscript>
    <p class="text-muted mt-3 text-xs">
      {t('contactForm.noscript')}
    </p>
  </noscript>

  <p class="text-muted mt-3 text-xs">
    {privacyBefore}<a href={loc('/legal/privacy-policy')} class="text-brand-700 underline"
      >{privacyLink}</a
    >{privacyAfter}
  </p>
</form>
