---
import Icon from './Icon.astro';

/**
 * The "see the rest" button that closes a section — an outline button that
 * floods brand blue from the left on hover while the arrow slides ahead.
 *
 * Shared so the two section footers that use it (ServicesCards, ModulesIntro)
 * cannot drift apart.
 */
interface Props {
  href: string;
  /** Opens in a new tab, and says so to assistive tech. */
  external?: boolean;
  class?: string;
}

const { href, external = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['ab-btn', className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="ab-fill" aria-hidden="true"></span>
  <slot />
  <Icon name="arrow-right" class="size-4" />
</a>

<style>
  .ab-btn {
    position: relative;
    display: inline-flex;
    isolation: isolate;
    overflow: hidden;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-btn);
    background: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-700);
    text-decoration: none;
    transition:
      transform 0.35s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.35s ease;
  }
  .ab-fill {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-brand-700));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.22, 0.9, 0.32, 1.2);
  }
  .ab-btn :global(svg) {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ab-btn:hover,
  .ab-btn:focus-visible {
    transform: translateY(-3px);
    border-color: var(--color-brand-700);
    color: #fff;
    box-shadow: 0 14px 28px color-mix(in srgb, var(--color-brand-500) 30%, transparent);
  }
  .ab-btn:hover .ab-fill,
  .ab-btn:focus-visible .ab-fill {
    transform: scaleX(1);
  }
  .ab-btn:hover :global(svg),
  .ab-btn:focus-visible :global(svg) {
    transform: translateX(6px);
  }
  .ab-btn:active {
    transform: translateY(-1px) scale(0.98);
  }
</style>
