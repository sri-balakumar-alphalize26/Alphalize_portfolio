---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '@/assets/brand/logo.png';
import { contact, legalNav, offices, site, socials } from '@/config/site';
import Icon from './Icon.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-brand-100 mt-24">
  <div class="container-page py-14 lg:py-18">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <Image
          src={logo}
          alt="Alphalize"
          widths={[180, 360]}
          sizes="180px"
          class="h-9 w-auto brightness-0 invert"
          loading="lazy"
        />
        <p class="text-brand-200 mt-4 max-w-sm text-sm leading-relaxed">
          {site.description}
        </p>
        <ul class="mt-6 flex gap-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="hover:bg-brand-600 flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors"
                >
                  <Icon name={s.icon} class="size-4" label={s.name} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <div class="lg:col-span-3">
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <a
                  href={`/services/${s.id}`}
                  class="text-brand-200 transition-colors hover:text-white"
                >
                  {s.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company -->
      <div class="lg:col-span-2">
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about" class="text-brand-200 hover:text-white">About</a></li>
          <li><a href="/careers" class="text-brand-200 hover:text-white">Careers</a></li>
          <li><a href="/contact" class="text-brand-200 hover:text-white">Contact</a></li>
          {
            legalNav.map((l) => (
              <li>
                <a href={l.href} class="text-brand-200 hover:text-white">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Offices -->
      <div class="lg:col-span-3">
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Offices</h2>
        <ul class="mt-4 space-y-4 text-sm">
          {
            offices.map((o) => (
              <li class="flex gap-2.5">
                <Icon name="pin" class="text-brand-400 mt-0.5 size-4 shrink-0" />
                <span class="text-brand-200">
                  <span class="block font-medium text-white">{o.label}</span>
                  {o.street}, {o.locality}, {o.region} {o.postalCode}
                </span>
              </li>
            ))
          }
          <li class="flex gap-2.5">
            <Icon name="phone" class="text-brand-400 mt-0.5 size-4 shrink-0" />
            <a href={contact.phoneHref} class="text-brand-200 hover:text-white">{contact.phone}</a>
          </li>
          <li class="flex gap-2.5">
            <Icon name="mail" class="text-brand-400 mt-0.5 size-4 shrink-0" />
            <a
              href={`mailto:${contact.emailUser}@${contact.emailDomain}`}
              class="text-brand-200 hover:text-white">{contact.emailUser}@{contact.emailDomain}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="text-brand-300 mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p>Kollam, Kerala</p>
    </div>
  </div>
</footer>
