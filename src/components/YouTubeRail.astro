---
import type { Talk } from '@/config/ceo';
import Icon from './Icon.astro';

/**
 * A row of YouTube talks, as click-to-load facades.
 *
 * Embedded players would pull YouTube's script and hand every visitor's IP to
 * Google before anyone pressed play. This site inlines every brand mark
 * specifically to avoid that (see social-marks.ts, ai-marks.ts), so a section
 * that undid it for a video rail would be working against the rest of the page.
 * Nothing is requested from youtube.com until a card is clicked.
 *
 * The poster is YouTube's own thumbnail, so it does come from an i.ytimg.com
 * URL — an image request, not a player, and the only way to show the real frame
 * without checking a file per video into the repo.
 *
 * With JS off the card stays a plain link to the video, which is why it is an
 * <a> to youtube.com rather than a button.
 */
interface Props {
  talks: Talk[];
  channel: string;
}

const { talks, channel } = Astro.props;
---

<ul class="yt-rail">
  {
    talks.map((t, i) => (
      <li class="ab ab-pop" style={`--d:${i * 90}ms`}>
        <a
          class="yt-card"
          href={`https://www.youtube.com/watch?v=${t.id}`}
          target="_blank"
          rel="noopener noreferrer"
          data-yt={t.id}
          data-yt-title={t.title}
        >
          <span class="yt-thumb">
            <img
              src={`https://i.ytimg.com/vi/${t.id}/hqdefault.jpg`}
              alt=""
              width="480"
              height="360"
              loading="lazy"
              decoding="async"
            />
            <span class="yt-play" aria-hidden="true" />
          </span>
          <span class="yt-meta">
            <span class="yt-title">{t.title}</span>
            <span class="yt-note">{t.note}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<p class="yt-channel">
  <a href={channel} target="_blank" rel="noopener noreferrer">
    Shan on Tech on YouTube
    <Icon name="megaphone" />
  </a>
</p>

<script>
  function initYouTubeRail() {
    document.querySelectorAll<HTMLAnchorElement>('[data-yt]').forEach((card) => {
      if (card.dataset.ytWired) return;
      card.dataset.ytWired = '1';

      card.addEventListener('click', (e) => {
        // Let modified clicks and middle-clicks open YouTube as a normal link.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();

        const thumb = card.querySelector('.yt-thumb');
        if (!thumb || thumb.querySelector('iframe')) return;

        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${card.dataset.yt}?autoplay=1&rel=0`;
        frame.title = card.dataset.ytTitle ?? 'Video';
        frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        frame.allowFullscreen = true;
        frame.loading = 'lazy';
        // appendChild, not append: the Workers types shadow the DOM append().
        thumb.appendChild(frame);
      });
    });
  }

  document.addEventListener('astro:page-load', initYouTubeRail);
  if (document.readyState !== 'loading') initYouTubeRail();
  else document.addEventListener('DOMContentLoaded', initYouTubeRail, { once: true });
</script>

<style>
  .yt-rail {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .yt-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .yt-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .yt-card {
    display: block;
    transition: transform 0.3s cubic-bezier(0.22, 0.9, 0.32, 1.2);
  }
  .yt-card:hover {
    transform: translateY(-3px);
  }

  .yt-thumb {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    background: var(--color-brand-950);
  }
  /* hqdefault is 4:3 with letterbox bars; cropping to 16:9 removes them. */
  .yt-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-soft);
  }
  .yt-card:hover .yt-thumb img {
    transform: scale(1.04);
  }
  .yt-thumb :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3rem;
    height: 2.125rem;
    margin: -1.0625rem 0 0 -1.5rem;
    border-radius: 0.5rem;
    background: rgb(224 47 47 / 0.92);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.5, 0.64, 1),
      background 0.25s ease;
  }
  /* The triangle, drawn with borders so it needs no second element. */
  .yt-play::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    margin: -0.4375rem 0 0 -0.25rem;
    border-style: solid;
    border-width: 0.4375rem 0 0.4375rem 0.75rem;
    border-color: transparent transparent transparent #fff;
  }
  .yt-card:hover .yt-play {
    background: #e02f2f;
    transform: scale(1.12);
  }

  .yt-meta {
    display: block;
    margin-top: 0.75rem;
  }
  .yt-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .yt-note {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .yt-channel {
    margin: 2rem 0 0;
    font-size: 0.875rem;
  }
  .yt-channel a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-plum-600);
    font-weight: 600;
    transition: color 0.25s ease;
  }
  .yt-channel a :global(svg) {
    width: 0.9375rem;
    height: 0.9375rem;
  }
  .yt-channel a:hover {
    color: var(--color-brand-600);
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-card,
    .yt-thumb img,
    .yt-play {
      transition: none;
    }
    .yt-card:hover,
    .yt-card:hover .yt-thumb img,
    .yt-card:hover .yt-play {
      transform: none;
    }
  }
</style>
