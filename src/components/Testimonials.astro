---
import { localeHref } from '@/i18n/paths';
import { getCollection } from 'astro:content';
import { ReviewCard, ReviewCardDefs } from '@alphalize/astro-marker';
import Reveal from './Reveal.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

/**
 * Client reviews as a vertical three-column wall. Cards come from the marker
 * package's <ReviewCard>; the columns scroll on the pure CSS .marquee-col rule
 * in global.css — the vertical counterpart to the horizontal .marquee-track the
 * logo strips use. Zero JavaScript.
 */
const reviews = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);

// Colour is bound to the review, not its slot, so a given person keeps the same
// mark wherever they surface in a column.
const palette = ['blue', 'orange', 'yellow'];
const cards = reviews.map((review, i) => ({ ...review.data, color: palette[i % palette.length] }));

/**
 * Each column carries six of the nine, starting a third of the way further
 * along than the one before it, and every card is rendered twice for the
 * seamless loop.
 *
 * Six rather than all nine: a column shows about three cards at a time, so six
 * is already twice the visible run — long enough that the repeat is never on
 * screen with its original. Carrying all nine put 54 cards in the document and
 * made the testimonial wall the heaviest section of the homepage; this is 36.
 * The offsets are still thirds, so no two columns show the same card level
 * with each other. Speeds differ so the columns never travel in lockstep, and
 * the middle one runs the other way.
 */
const PER_COLUMN = 6;
const columns = [0, 3, 6].map((offset, i) => ({
  items: [...cards.slice(offset), ...cards.slice(0, offset)].slice(0, PER_COLUMN),
  duration: [46, 58, 52][i],
  reverse: i === 1,
  visibility: ['', 'hidden md:block', 'hidden lg:block'][i],
}));

const { locale, t } = Astro.locals;
/** Prefix an internal path with this page's locale. */
const loc = (to: string) => localeHref(locale, to);
---

<Section variant="surface" space="lg">
  {
    /* Once for the whole wall. Every card's quote mark and stars are <use>
       references into this — 54 cards each carrying their own copies was 99 KB,
       29% of the homepage. */
  }
  <ReviewCardDefs />
  <SectionHeading
    eyebrow={t('testimonials.eyebrow')}
    title={t('testimonials.title')}
    marker="underline"
    color="blue"
    lead={t('testimonials.lead')}
  />

  <div
    class="marquee-y relative mt-12 grid h-[30rem] grid-cols-1 gap-6 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_10%,black_90%,transparent)] md:grid-cols-2 lg:h-[34rem] lg:grid-cols-3"
  >
    {
      columns.map((col) => (
        <div class={col.visibility}>
          {/* gap clears the "66" mark, which sits 18px above each card */}
          <div
            class="marquee-col gap-9"
            data-reverse={col.reverse ? '' : undefined}
            style={`--marquee-duration:${col.duration}s`}
          >
            {[...col.items, ...col.items].map((card, i) => {
              const clone = i >= col.items.length;
              return (
                <div data-clone={clone ? '' : undefined} aria-hidden={clone ? 'true' : undefined}>
                  <ReviewCard name={card.name} rating={card.rating} color={card.color}>
                    {card.quote}
                  </ReviewCard>
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>

  <Reveal class="text-muted mt-10 text-center text-sm">
    {t('testimonials.footer')}
    <a href={loc('/contact')} class="text-plum-600 font-semibold hover:underline"
      >{t('misc.tellUsHowItWent')}</a
    >.
  </Reveal>
</Section>
