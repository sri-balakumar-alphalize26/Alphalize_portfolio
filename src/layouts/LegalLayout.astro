---
import PageHero from '@/components/PageHero.astro';
import BaseLayout from './BaseLayout.astro';
import { legalNav } from '@/config/site';
import { cleanPathname } from '@/i18n/paths';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
// Normalised, or the comparison below is '/legal/privacy-policy.html' against
// '/legal/privacy-policy' and no sidebar link is ever marked current.
const path = cleanPathname(Astro.url.pathname);
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} eyebrow="Legal" />

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <article class="lg:col-span-8">
      <p class="text-muted text-xs">Last updated: {updated}</p>
      <div class="prose-content mt-4">
        <slot />
      </div>
    </article>

    <aside class="lg:col-span-4">
      <nav class="lg:sticky lg:top-28" aria-label="Legal pages">
        <h2 class="text-ink text-sm font-semibold tracking-wider uppercase">Legal</h2>
        <ul class="divide-brand-100 mt-3 divide-y">
          {
            legalNav.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={path === l.href ? 'page' : undefined}
                  class:list={[
                    'block py-2.5 text-sm transition-colors',
                    path === l.href
                      ? 'text-brand-700 font-semibold'
                      : 'text-muted hover:text-brand-700',
                  ]}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>
