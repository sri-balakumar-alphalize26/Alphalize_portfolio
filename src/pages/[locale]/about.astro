---
import AboutAnim from '@/components/AboutAnim.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import TrustedPartners from '@/components/TrustedPartners.astro';
import WhyChooseUs from '@/components/WhyChooseUs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { offices, site } from '@/config/site';
import { localeHref } from '@/i18n/paths';

const { locale, t } = Astro.locals;
export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';

/** Names what this page is and ties it to the company it describes. */
const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: new URL(localeHref(locale, '/about'), site.url).href,
  name: t('aboutPage.metaTitle'),
  description: t('aboutPage.metaDescription'),
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout
  title={t('aboutPage.metaTitle')}
  description={t('aboutPage.metaDescription')}
  jsonLd={[aboutPage]}
>
  <AboutAnim />

  <PageHero
    anim
    eyebrow={t('aboutPage.eyebrow')}
    title={t('aboutPage.title')}
    lead={t('aboutPage.lead')}
  />

  {
    /*
    Narrative. Driven by <AboutAnim> rather than <Reveal>: the two cannot share
    an element, because [data-reveal]'s `animation-timeline: view()` animation
    would override the .ab transition on opacity/transform.
  */
  }
  <section class="container-page py-16 lg:py-20" data-ab data-hold="1000">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="prose-content">
          <p class="ab ab-left" style="--d:0ms">
            {t('aboutPage.para1')}
          </p>
          <h2 class="ab ab-left" style="--d:170ms">
            <span class="ab-underline">{t('aboutPage.visionHeading')}</span>
          </h2>
          <p class="ab ab-left" style="--d:300ms">
            {t('aboutPage.para2')}
          </p>
          <p class="ab ab-left" style="--d:420ms">
            {t('aboutPage.para3')}
          </p>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div
          class="cc-surface rounded-card border-brand-100 ab ab-card border p-7"
          style="--d:230ms"
        >
          <h2 class="text-ink ab text-base font-semibold" style="--d:520ms">
            {t('aboutPage.whereWeWork')}
          </h2>
          <ul class="mt-4 space-y-5">
            {
              offices.map((o, i) => (
                <li class="flex gap-3">
                  <span
                    class="rounded-btn text-plum-600 ab-pin mt-0.5 flex size-9 shrink-0 items-center justify-center bg-white"
                    style={`--d:${680 + i * 190}ms`}
                  >
                    <Icon name="pin" class="size-4" />
                  </span>
                  <span
                    class="text-muted ab text-sm leading-relaxed"
                    style={`--d:${740 + i * 190}ms`}
                  >
                    <span class="text-ink block font-semibold">{o.label}</span>
                    {o.street}
                    <br />
                    {o.locality}, {o.region} {o.postalCode}
                  </span>
                </li>
              ))
            }
          </ul>
          <span class="ab-line bg-brand-200/60 mt-6 block h-px" style="--d:1080ms"></span>
          <p class="text-muted ab mt-5 text-sm leading-relaxed" style="--d:1220ms">
            {t('aboutPage.supportNote')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <WhyChooseUs />

  <TrustedPartners />

  <CtaBand />
</BaseLayout>
