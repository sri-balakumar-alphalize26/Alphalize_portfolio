---
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import Reveal from '@/components/Reveal.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact, offices } from '@/config/site';

const email = `${contact.emailUser}@${contact.emailDomain}`;
---

<BaseLayout
  title="Contact"
  description="Talk to Alphalize about ERP, business intelligence or custom software. Office in Kollam, Kerala."
>
  <PageHero
    eyebrow="Contact"
    title="Contact Us"
    lead="Describe your current setup and what you want to change. We will come back with a straight assessment rather than a sales deck."
  />

  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Details -->
      <div class="lg:col-span-5">
        <Reveal direction="left" class="space-y-4">
          <a
            href={contact.phoneHref}
            class="rounded-card border-brand-100 hover:border-brand-200 hover:bg-brand-50/50 flex gap-4 border p-5 transition-colors"
          >
            <span
              class="rounded-btn bg-plum-600 flex size-11 shrink-0 items-center justify-center text-white"
            >
              <Icon name="phone" class="size-5" />
            </span>
            <span>
              <span class="text-ink block text-sm font-semibold">Call us</span>
              <span class="text-muted mt-0.5 block text-sm">{contact.phone}</span>
            </span>
          </a>

          <a
            href={`mailto:${email}`}
            class="rounded-card border-brand-100 hover:border-brand-200 hover:bg-brand-50/50 flex gap-4 border p-5 transition-colors"
          >
            <span
              class="rounded-btn bg-plum-600 flex size-11 shrink-0 items-center justify-center text-white"
            >
              <Icon name="mail" class="size-5" />
            </span>
            <span>
              <span class="text-ink block text-sm font-semibold">Email us</span>
              <span class="text-muted mt-0.5 block text-sm break-all">{email}</span>
            </span>
          </a>

          <div class="rounded-card border-brand-100 border p-5">
            <h2 class="text-ink text-sm font-semibold">Office addresses</h2>
            <ul class="mt-4 space-y-5">
              {
                offices.map((o) => (
                  <li class="flex gap-4">
                    <span class="rounded-btn bg-plum-50 text-plum-600 flex size-11 shrink-0 items-center justify-center">
                      <Icon name="pin" class="size-5" />
                    </span>
                    <span class="text-muted text-sm leading-relaxed">
                      <span class="text-ink block font-semibold">{o.label}</span>
                      {o.street}
                      <br />
                      {o.locality}, {o.region} {o.postalCode}
                      <br />
                      {o.country}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="cc-surface rounded-card border-brand-100 flex gap-4 border p-5">
            <span
              class="rounded-btn text-plum-600 flex size-11 shrink-0 items-center justify-center bg-white"
            >
              <Icon name="clock" class="size-5" />
            </span>
            <span class="text-muted text-sm leading-relaxed">
              <span class="text-ink block font-semibold">Response time</span>
              We aim to reply within one business day, with 24/7 support cover across Indian, Gulf and
              US business hours.
            </span>
          </div>
        </Reveal>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7">
        <Reveal direction="right">
          <ContactForm />
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>
