---
import { getCollection } from 'astro:content';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Alphalize services',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.data.title,
      url: `${site.url}/services/${s.id}`,
    })),
  },
];
---

<BaseLayout
  title="Services"
  description="ERP solutions, business intelligence, custom web and mobile development, integration and migration, digital marketing, and training from Alphalize."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="What we do"
    title="Services"
    lead="Seven service lines covering the software side of running a modern operation — from a full ERP rollout to the integrations, dashboards and apps that make it useful day to day."
  />

  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <ServiceCard service={service} delay={i % 3} featured={service.data.featured} />
        ))
      }
    </div>
  </section>

  <CtaBand
    title="Not sure which of these you need?"
    body="Most engagements start as one thing and turn out to be another. Describe the problem and we will tell you which service actually addresses it — including when the answer is none of them."
  />
</BaseLayout>
