---
import { getCollection } from 'astro:content';
import AppCard from './AppCard.astro';
import SectionHeading from './SectionHeading.astro';

/** Rendered on /services/mobile-app-development via `showcase: apps`. */
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const { t } = Astro.locals;
---

{
  apps.length > 0 && (
    <section id="apps" class="cc-surface border-brand-100 scroll-mt-24 border-t py-16 lg:py-20">
      <div class="container-page">
        {/* Its own [data-ab] unit: the cards below each become one too, so the
            heading cannot share theirs. */}
        <div data-ab>
          <SectionHeading
            anim
            eyebrow={t('appShowcase.eyebrow')}
            title={t('appShowcase.title')}
            color="sky"
            lead={t('appShowcase.lead')}
          />
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {apps.map((app, i) => (
            <AppCard app={app} delay={i % 3} />
          ))}
        </div>
      </div>
    </section>
  )
}
