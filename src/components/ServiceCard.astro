---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Reveal from './Reveal.astro';

interface Props {
  service: CollectionEntry<'services'>;
  delay?: number;
}

const { service, delay = 0 } = Astro.props;
const { title, summary, icon } = service.data;
---

<Reveal as="article" delay={delay} class="group h-full">
  <a
    href={`/services/${service.id}`}
    class="flex h-full flex-col rounded-card border border-brand-100 bg-white p-6 transition-[border-color,box-shadow] duration-300 ease-out-soft hover:border-plum-300 hover:shadow-lift"
  >
    <span
      class="flex size-12 items-center justify-center rounded-btn bg-plum-50 text-plum-600 transition-colors duration-300 group-hover:bg-plum-600 group-hover:text-white"
    >
      <Icon name={icon} class="size-6" />
    </span>

    <h3 class="mt-5 text-lg font-semibold text-ink">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{summary}</p>

    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 group-hover:text-plum-600">
      Learn more
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-1"
      />
    </span>
  </a>
</Reveal>
