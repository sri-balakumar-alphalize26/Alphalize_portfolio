---
import { getLocalized } from '@/i18n/collections';
import { getCollection } from 'astro:content';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { localeHref } from '@/i18n/paths';

const { locale, t } = Astro.locals;
const services = await getLocalized('services', locale);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Alphalize services',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.entry.data.title,
      /**
       * Through localeHref, like every other JSON-LD URL on the site.
       *
       * This used to be `${site.url}/services/${s.slug}` — no locale segment —
       * so all nine locales published the English URL here, and each one 301s
       * through public/_redirects before it resolves. A list that advertises
       * nine identical English URLs tells a crawler the nine pages are one
       * page, which is the opposite of what the hreflang set says.
       */
      url: new URL(localeHref(locale, `/services/${s.slug}`), site.url).href,
    })),
  },
];
export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';
---

<BaseLayout
  title={t('servicesPage.metaTitle')}
  description={t('servicesPage.metaDescription')}
  jsonLd={jsonLd}
  ogImagePath="/og/services.png"
>
  <PageHero
    eyebrow={t('servicesPage.eyebrow')}
    title={t('servicesPage.title')}
    lead={t('servicesPage.lead')}
  />

  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <ServiceCard service={service} delay={i % 3} featured={service.entry.data.featured} />
        ))
      }
    </div>
  </section>

  <CtaBand
    title={t('servicesPage.ctaTitle')}
    body="Most engagements start as one thing and turn out to be another. Describe the problem and we will tell you which service actually addresses it — including when the answer is none of them."
  />
</BaseLayout>
