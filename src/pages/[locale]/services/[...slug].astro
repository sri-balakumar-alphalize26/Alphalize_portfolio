---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import AboutAnim from '@/components/AboutAnim.astro';
import AppShowcase from '@/components/AppShowcase.astro';
import CtaBand from '@/components/CtaBand.astro';
import DesktopSoftware from '@/components/DesktopSoftware.astro';
import ModulesGrid from '@/components/ModulesGrid.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceSidebar from '@/components/ServiceSidebar.astro';
import SolutionCards from '@/components/SolutionCards.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { liveLocales, type Locale } from '@/i18n/locales';
import { localeHref } from '@/i18n/paths';
import { getLocalized } from '@/i18n/collections';

/**
 * Every live locale gets every slug, translated or not.
 *
 * A locale missing a translation must still resolve the URL rather than 404:
 * the header dropdown, the footer list and the 404 rail are all built from the
 * English set, so the site links every slug in every locale regardless. The
 * fallback is English prose, and it is marked as such below.
 */
export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    liveLocales.map(async (locale) => {
      const services = await getLocalized('services', locale);
      return services.map(({ slug, entry, translated }) => ({
        params: { locale, slug },
        props: { service: entry, translated },
      }));
    })
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

const { service, translated } = Astro.props;
const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const { title, titleMarked, summary, seoDescription, icon, highlights, showcase, solutions } =
  service.data;
const { Content } = await render(service);

// The mobile page lists the apps as SoftwareApplication entries for search engines.
const apps =
  showcase === 'apps'
    ? (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order)
    : [];

/* Sibling services for the "explore more" rail — localised, so the rail follows
   the same fallback rules as the page and its links carry no locale prefix in
   the slug. Reading the raw collection here would emit "/en/services/en/…". */
const others = (await getLocalized('services', locale)).filter((s) => s.slug !== slug);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: title,
    description: seoDescription ?? summary,
    url: new URL(localeHref(locale, `/services/${slug}`), site.url).href,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: ['IN'],
  },
];

if (apps.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Alphalize mobile apps',
    itemListElement: apps.map((app, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: app.data.title,
        description: app.data.tagline,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Android',
        author: { '@id': `${site.url}/#organization` },
      },
    })),
  });
}
---

<BaseLayout title={title} description={seoDescription ?? summary} ogType="article" jsonLd={jsonLd}>
  <AboutAnim />

  <PageHero
    anim
    eyebrow="Service"
    title={titleMarked}
    lead={summary}
    crumbs={[{ label: 'Services', href: localeHref(locale, '/services') }]}
  />

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-20">
    {
      /* Body. One [data-ab] unit with an auto-assigned stagger: the blocks come
        from rendered markdown, so there is no template to annotate them in. */
    }
    {
      /*
      lang="en" whenever this locale has no translation of its own.

      This is the one thing that must not be skipped on a fallback. It tells a
      screen reader to switch voice rather than read English with an Arabic or
      Tamil pronunciation, tells search engines the block is English inside a
      page declared otherwise, and stops a browser's translate feature
      re-translating text that is already in its source language. dir is set
      too, because English inside an RTL page is still an LTR run.
    */
    }
    <article
      class="prose-content lg:col-span-8"
      lang={translated ? undefined : 'en'}
      dir={translated ? undefined : 'ltr'}
      data-ab
      data-ab-cascade
      data-base="0"
      data-step="90"
    >
      <Content />
    </article>

    <aside class="lg:col-span-4">
      <ServiceSidebar icon={icon} highlights={highlights} others={others} />
    </aside>
  </div>

  {showcase === 'apps' && <AppShowcase />}
  {
    showcase === 'erp' && (
      <>
        <ModulesGrid />
        <DesktopSoftware />
      </>
    )
  }
  {
    showcase === 'iot' && solutions && solutions.length > 0 && (
      <SolutionCards solutions={solutions} />
    )
  }

  <CtaBand />
</BaseLayout>
