---
import { filledIcons, iconPaths, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  /** Supply to expose the icon to assistive tech; otherwise it is decorative. */
  label?: string;
  /**
   * Add `pathLength="1"` to every subpath so the shape can be drawn on with
   * `stroke-dasharray: 1; stroke-dashoffset: 1 → 0`. Normalising the length
   * keeps that exact for any icon, instead of guessing a dasharray per glyph.
   */
  draw?: boolean;
}

/**
 * `rest` carries the caller's `data-astro-cid-*`. Astro passes it as a prop but
 * does not put it on this root, and this component has no <style> of its own,
 * so without the spread the rendered <svg> has no scope attribute at all and
 * every rule a parent writes for the class it passed — `.ls-chev`, `.bs-check`
 * — matches nothing. The `size-6` default below only covers callers that pass
 * no class; one that passes `class="ls-chev"` replaces it and is then unsized.
 */
const { name, class: className = 'size-6', label, draw = false, ...rest } = Astro.props;

/**
 * Icons that mean "forward" and "back" rather than "left" and "right", so they
 * have to follow the reading direction.
 *
 * Handled here rather than at the call sites: these four are used at 21 places
 * across 17 files, and one shared component is the only way to get all of them
 * without missing any. The rule lives in global.css — `[dir='rtl'] .rtl-mirror`.
 *
 * Deliberately not every icon: a phone, a pin or a chevron-down means the same
 * thing in both directions, and mirroring those would just look wrong.
 *
 * Typed as IconName rather than string, so a name that is not in the set is a
 * build error. That is not hypothetical — this list started with arrow-left and
 * chevron-left, neither of which this project has, and the annotation is what
 * said so instead of silently never matching.
 */
const MIRRORED: readonly IconName[] = ['arrow-right', 'chevron-right'];

// `instagram` is drawn as a line icon despite being a brand mark.
const isFilled = filledIcons.includes(name) && name !== 'instagram';
const path = iconPaths[name];
const markup = draw
  ? path.replace(/<(path|circle|rect|line|polyline|polygon|ellipse)\b/g, '$& pathLength="1"')
  : path;
---

<svg
  class:list={[className, MIRRORED.includes(name) && 'rtl-mirror']}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
  set:html={markup}
/>
