---
import Field from './Field.astro';
import PhoneField from './PhoneField.astro';
import Icon from './Icon.astro';
---

{/* No action and no data-enhance: submitting composes a WhatsApp message and
    opens it, exactly as the 369 enquiry form does. Nothing is posted, so the
    enquiry only reaches us once the visitor presses send in WhatsApp. */}
<form class="rounded-card border-brand-100 border bg-white p-6 sm:p-8">
  <h2 class="text-xl font-semibold text-ink">Get in touch</h2>
  <p class="mt-1.5 text-sm text-muted">
    Tell us what you are trying to change. We reply to every enquiry.
  </p>

  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <Field name="name" label="Name" required autocomplete="name" placeholder="Your full name" />
    <Field
      name="email"
      label="Email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@company.com"
    />
    <PhoneField name="phone" label="Phone" required placeholder="70252 05503" />
    <Field name="subject" label="Subject" required placeholder="What is this about?" />
    <Field
      name="message"
      label="Message"
      type="textarea"
      required
      class="sm:col-span-2"
      placeholder="A few lines on your current setup and what you would like to improve."
    />
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button type="submit" data-wa-send class="btn btn-primary w-full sm:w-auto">
      Send message
      <Icon name="whatsapp" class="size-4" />
    </button>

    {/* WhatsApp opens in a new tab; if a popup blocker ate it, say so rather
        than leaving the visitor wondering whether anything happened. */}
    <p class="text-muted text-sm" role="status" aria-live="polite" data-wa-hint></p>
  </div>

  <p class="text-muted mt-3 text-xs">
    This opens WhatsApp with your details already written — press send there to reach us.
  </p>

  <noscript>
    <p class="text-muted mt-3 text-xs">
      This form needs JavaScript. Use the phone, WhatsApp or email links beside it instead.
    </p>
  </noscript>

  <p class="text-muted mt-3 text-xs">
    We use your details only to respond to this enquiry. See our
    <a href="/legal/privacy-policy" class="text-brand-700 underline">privacy policy</a>.
  </p>
</form>

