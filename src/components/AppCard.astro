---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

/**
 * One Android app. The card assembles rather than simply rising: the logo tray
 * lights up and the artwork pops in, the body unrolls downward beneath it, then
 * the feature checklist ticks itself in line by line.
 *
 * Each card is its own [data-ab] unit, so rows arrive as you scroll to them and
 * the column index ripples them left → right. Trigger comes from <AboutAnim>,
 * which the service page loads.
 */
interface Props {
  app: CollectionEntry<'apps'>;
  /** Column index, turned into the ripple offset. */
  delay?: number;
}

const { app, delay = 0 } = Astro.props;
const { title, tagline, image, features, platform } = app.data;
---

<article
  id={`app-${app.id}`}
  class="app-card rounded-card border-brand-100 flex h-full flex-col overflow-hidden border bg-white"
  data-ab
  style={`--d:${delay * 120}ms`}
>
  <!-- Artwork is a transparent wordmark logo: show it contained at a fixed, modest height. -->
  <div class="app-tray bg-surface relative flex h-28 items-center justify-center px-8">
    <span class="app-glow" aria-hidden="true"></span>
    <Image
      src={image}
      alt={`${title} logo`}
      height={64}
      densities={[1, 2]}
      class="app-logo relative h-16 w-auto max-w-full object-contain"
      loading="lazy"
    />
  </div>

  <div class="app-body flex flex-1 flex-col p-6">
    <span class="text-plum-600 text-[11px] font-semibold tracking-[0.16em] uppercase">
      {platform === 'tablet' ? 'Android · tablet' : 'Android'}
    </span>
    <h3 class="text-ink mt-1.5 text-lg font-semibold">{title}</h3>
    <p class="text-muted mt-1 text-sm leading-relaxed">{tagline}</p>

    <ul class="mt-4 space-y-2">
      {
        features.map((f, k) => (
          <li class="text-muted flex gap-2.5 text-sm leading-relaxed" style={`--k:${k}`}>
            <Icon name="check" draw class="app-tick text-plum-600 mt-0.5 size-4 shrink-0" />
            <span>{f}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .app-card {
    /* Arriving from the app marquee, which links to #app-<id>: clear the
       sticky header before flagging the card. */
    scroll-margin-top: 6rem;
    transition:
      transform 0.4s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.35s ease,
      box-shadow 0.4s ease;
  }
  .app-logo {
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.35s ease;
  }

  .app-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-plum-300);
    box-shadow: var(--shadow-lift);
  }
  .app-card:hover .app-logo {
    transform: scale(1.09) translateY(-2px);
    filter: drop-shadow(0 8px 14px rgb(4 30 57 / 0.22));
  }
  .app-card:hover h3 {
    color: var(--color-plum-600);
  }
  .app-card h3 {
    transition: color 0.3s ease;
  }

  /* --- entrance --- */
  :global(html.ab-js) .app-card {
    opacity: 0;
    transition:
      opacity 0.4s ease,
      transform 0.4s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.35s ease,
      box-shadow 0.4s ease;
    transition-delay: calc(var(--b, 0ms) + var(--d, 0ms));
  }
  :global(html.ab-js) .app-card.in {
    opacity: 1;
  }

  /* The logo pops in over a radial flash. */
  .app-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.4);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-brand-500) 20%, transparent),
      transparent 66%
    );
  }
  :global(html.ab-js) .app-logo {
    opacity: 0;
    transform: translateY(10px) scale(0.55);
    transition:
      opacity 0.45s ease,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--b, 0ms) + var(--d, 0ms) + 120ms);
  }
  :global(html.ab-js) .app-card.in .app-logo {
    opacity: 1;
    transform: none;
  }
  .app-card.in .app-glow {
    animation: app-glow 0.9s ease-out forwards;
    animation-delay: calc(var(--b, 0ms) + var(--d, 0ms) + 120ms);
  }
  @keyframes app-glow {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    30% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  /* The body unrolls downward under the tray. */
  :global(html.ab-js) .app-body {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s cubic-bezier(0.62, 0.03, 0.21, 1);
    transition-delay: calc(var(--b, 0ms) + var(--d, 0ms) + 320ms);
  }
  :global(html.ab-js) .app-card.in .app-body {
    clip-path: inset(0 0 0 0);
  }

  /* Each checklist line ticks itself in. `draw` on <Icon> normalises the path
     to length 1, so the dash maths is exact rather than guessed. */
  .app-card :global(.app-tick path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(html.ab-js) .app-card.in :global(.app-tick path) {
    animation: app-tick 0.4s cubic-bezier(0.55, 0, 0.35, 1) forwards;
    animation-delay: calc(var(--b, 0ms) + var(--d, 0ms) + 820ms + var(--k, 0) * 140ms);
  }
  @keyframes app-tick {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Once settled, drop the entrance delay and release the clip so hover and
     :target are not held behind the stagger. */
  :global(html.ab-js) .app-card.in.done {
    transition-delay: 0s;
  }
  :global(html.ab-js) .app-card.in.done .app-logo {
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.35s ease;
    transition-delay: 0s;
  }
  :global(html.ab-js) .app-card.in.done .app-body {
    clip-path: none;
  }

  /* Deep-linked from the marquee: ripple twice so the right card is obvious
     in a grid of ten. */
  .app-card:target {
    border-color: var(--color-plum-400);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--color-plum-600) 22%, transparent),
      var(--shadow-lift);
  }
  @media (prefers-reduced-motion: no-preference) {
    .app-card:target {
      animation: app-flag 1.2s var(--ease-out-soft) 2;
    }
  }
  @keyframes app-flag {
    from {
      box-shadow:
        0 0 0 0 color-mix(in srgb, var(--color-plum-600) 45%, transparent),
        var(--shadow-lift);
    }
    to {
      box-shadow:
        0 0 0 14px color-mix(in srgb, var(--color-plum-600) 0%, transparent),
        var(--shadow-lift);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.ab-js) .app-card,
    :global(html.ab-js) .app-logo {
      opacity: 1 !important;
      transform: none !important;
      transition: none;
    }
    :global(html.ab-js) .app-body {
      clip-path: none;
      transition: none;
    }
    .app-card :global(.app-tick path) {
      stroke-dashoffset: 0;
      animation: none !important;
    }
    .app-card.in .app-glow {
      animation: none;
    }
    .app-card,
    .app-logo {
      transition: none;
    }
  }
</style>
