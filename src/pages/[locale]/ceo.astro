---
import AboutAnim from '@/components/AboutAnim.astro';
import CtaBand from '@/components/CtaBand.astro';
import LeaderCard from '@/components/LeaderCard.astro';
import AwardBlock from '@/components/AwardBlock.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import YouTubeRail from '@/components/YouTubeRail.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ceo, talks } from '@/config/ceo';
import { site } from '@/config/site';
import { localeHref } from '@/i18n/paths';

/**
 * The Managing Director's page, from the 369 /ceo.
 *
 * Four bands: <LeaderCard> for the portrait and bio, then the BizConnect
 * award, his talks, and the CTA. The copy is rewritten — see the note in
 * src/config/ceo.ts on what changed and why.
 *
 * MOTION. Each band owns its own entrance and its own [data-ab] unit, so they
 * reveal as they are scrolled to rather than all at once. The engine is
 * about-anim.ts: html.ab-js arms the hidden states, .in releases them.
 */
export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';
const { locale, t } = Astro.locals;

/**
 * The person, tied to the company. Every field here already existed in
 * config/ceo.ts and was going only to the page, not to search engines — which
 * is why a search for the name returned nothing about this site.
 */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#ceo`,
  name: ceo.name,
  jobTitle: t('ceoPage.role'),
  description: t('ceoPage.intro1').slice(0, 155),
  url: new URL(localeHref(locale, '/ceo'), site.url).href,
  image: new URL(ceo.portrait.src, site.url).href,
  worksFor: { '@id': `${site.url}/#organization` },
  sameAs: [ceo.talks.channel],
};
---

<BaseLayout
  title={`${ceo.name} — ${t('ceoPage.role')}`}
  description={t('ceoPage.intro1').slice(0, 155)}
  jsonLd={[person]}
  ogImagePath="/og/ceo.png"
>
  <AboutAnim />

  {/* Portrait, name, role and bio, with its own entrance — see LeaderCard. */}
  <LeaderCard />

  {/* Kicker, heading, the two dealt photos and the presentation clip. */}
  <AwardBlock />

  <Section variant="white" space="lg">
    <div data-ab>
      <SectionHeading anim title={t('ceoPage.talksTitle')} lead={t('ceoPage.talksBody')} />
      <div class="mt-12">
        <YouTubeRail talks={talks} channel={ceo.talks.channel} />
      </div>
    </div>
  </Section>

  <CtaBand title={t('ceoPage.ctaTitle')} body={t('ceoPage.ctaBody')} />
</BaseLayout>
