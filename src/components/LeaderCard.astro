---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { ceo } from '@/config/ceo';
import { localeHref } from '@/i18n/paths';

/**
 * Leadership block — portrait left, bio right, on the dark ground.
 *
 * Motion, all on first scroll into view via the shared [data-ab] engine:
 *   1. a soft blue aura blooms behind the portrait
 *   2. the portrait unmasks bottom→top while easing out of a 1.12 scale, so it
 *      settles rather than simply appearing
 *   3. a hairline frame draws itself around the photo — top and left run out
 *      from the corner together, right and bottom follow — then a corner
 *      bracket snaps in
 *   4. the right column rises in sequence: kicker, name (masked slide-up),
 *      role, rule, paragraphs, button
 *   5. the button's border traces once when it lands
 *
 * Hover: the portrait lifts and its frame brightens; the button fills.
 *
 * The frame is four separate 1px edges rather than one SVG rect, because a
 * rect distorts under the non-uniform scaling that draws it on.
 *
 * Every class is `ld-` prefixed. Scoping would make bare names safe, but `.btn`
 * and `.eyebrow` are real global components here and a scoped rule of the same
 * name silently layers on top of them.
 *
 * Copy defaults to src/config/ceo.ts, so the page and this card cannot drift.
 */
interface Props {
  photo?: ImageMetadata;
  name?: string;
  role?: string;
  paras?: string[];
  kicker?: string;
  cta?: string;
  ctaHref?: string;
}

const { locale, t } = Astro.locals;
const {
  photo = ceo.portrait,
  name = ceo.name,
  role = `${t('ceoPage.role')} · ${ceo.company}`,
  paras = [t('ceoPage.intro1'), t('ceoPage.intro2')],
  kicker = t('nav.leadership'),
  cta = t('ceoPage.cardCta'),
  // Locale-prefixed, or a non-English reader is sent to the English contact page.
  ctaHref = localeHref(locale, '/contact'),
} = Astro.props;
---

<section class="lead" data-ab data-hold="120">
  <div class="container-page ld-wrap">
    <figure class="ld-shot">
      <span class="ld-aura" aria-hidden="true"></span>

      <span class="ld-frame" aria-hidden="true">
        <i class="ld-e ld-t"></i><i class="ld-e ld-r"></i><i class="ld-e ld-b"></i><i
          class="ld-e ld-l"></i>
      </span>

      <span class="ld-bracket" aria-hidden="true"></span>

      <span class="ld-mask">
        <Image
          src={photo}
          alt={t('ceoPage.portraitAlt')}
          widths={[330, 660]}
          sizes="(min-width: 1024px) 330px, 280px"
          loading="eager"
        />
      </span>
    </figure>

    <div class="ld-bio">
      <p class="ld-kick" style="--d:340ms">{kicker}</p>

      <h1 class="ld-name" style="--d:420ms"><span>{name}</span></h1>

      <p class="ld-role" style="--d:560ms">{role}</p>
      <span class="ld-rule" style="--d:640ms" aria-hidden="true"></span>

      {
        paras.map((t, i) => (
          <p class="ld-para" style={`--d:${720 + i * 110}ms`}>
            {t}
          </p>
        ))
      }

      <a class="ld-btn" href={ctaHref} style="--d:960ms">
        <svg class="ld-trace" viewBox="0 0 200 46" preserveAspectRatio="none" aria-hidden="true">
          <rect x="1" y="1" width="198" height="44" rx="7" pathLength="1"></rect>
        </svg>
        <span class="ld-fill" aria-hidden="true"></span>
        <span class="ld-lab">{cta}</span>
        <Icon name="arrow-right" class="ld-arw" />
      </a>
    </div>
  </div>
</section>

<style>
  .lead {
    background: var(--color-brand-950);
    color: #fff;
    padding: 4.625rem 0;
  }
  .ld-wrap {
    display: grid;
    grid-template-columns: 330px 1fr;
    gap: 3.25rem;
    align-items: start;
  }

  /* ---------- portrait ---------- */
  .ld-shot {
    position: relative;
    margin: 0;
    aspect-ratio: 62 / 80;
  }
  .ld-mask {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.05);
  }
  .ld-mask :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* The aura sits behind everything and gives the cut-out photo somewhere to land. */
  .ld-aura {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-brand-400) 42%, transparent),
      transparent 72%
    );
    filter: blur(26px);
    opacity: 0;
    transform: scale(0.7);
  }

  .ld-frame {
    position: absolute;
    inset: -11px;
    pointer-events: none;
  }
  .ld-e {
    position: absolute;
    background: color-mix(in srgb, var(--color-brand-300) 50%, transparent);
    transition: background 0.35s ease;
  }
  .ld-t {
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    transform-origin: left center;
  }
  .ld-r {
    top: 0;
    bottom: 0;
    right: 0;
    width: 1px;
    transform-origin: center top;
  }
  .ld-l {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    transform-origin: center top;
  }
  .ld-b {
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    transform-origin: left center;
  }

  /* A solid corner that snaps in after the line finishes. */
  .ld-bracket {
    position: absolute;
    left: -11px;
    top: -11px;
    width: 34px;
    height: 34px;
    pointer-events: none;
    border-inline-start: 2px solid var(--color-brand-400);
    border-top: 2px solid var(--color-brand-400);
    border-radius: 4px 0 0 0;
    opacity: 0;
    transform: translate(-6px, -6px);
  }

  .ld-shot:hover .ld-mask :global(img) {
    transform: scale(1.04);
  }
  .ld-shot:hover .ld-e {
    background: color-mix(in srgb, var(--color-brand-300) 90%, transparent);
  }

  /* ---------- bio ---------- */
  .ld-bio {
    padding-top: 0.375rem;
  }
  .ld-kick {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-400);
  }
  .ld-name {
    margin: 0 0 0.625rem;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #fff;
    overflow: hidden;
  }
  .ld-name span {
    display: inline-block;
  }
  .ld-role {
    margin: 0 0 1.125rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-brand-300);
  }
  .ld-rule {
    display: block;
    width: 64px;
    height: 2px;
    margin-bottom: 1.25rem;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-brand-400), var(--color-plum-600));
    transform-origin: left center;
  }
  .ld-para {
    margin: 0 0 0.9375rem;
    max-width: 660px;
    font-size: 0.90625rem;
    line-height: 1.85;
    color: var(--color-brand-200);
  }

  /* ---------- button ---------- */
  .ld-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    margin-top: 0.75rem;
    padding: 0 1.375rem;
    border-radius: 7px;
    background: #fff;
    color: var(--color-brand-800);
    font-size: 0.84375rem;
    font-weight: 600;
    line-height: 1;
    transition:
      transform 0.3s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      box-shadow 0.3s ease,
      color 0.3s ease;
  }
  .ld-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-brand-400), var(--color-brand-500));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.44s cubic-bezier(0.22, 0.9, 0.32, 1.12);
  }
  .ld-lab {
    position: relative;
    transition: transform 0.38s cubic-bezier(0.22, 0.9, 0.32, 1.12);
  }
  .ld-btn :global(.ld-arw) {
    position: absolute;
    right: 13px;
    width: 15px;
    height: 15px;
    opacity: 0;
    transform: translateX(-5px);
    transition:
      opacity 0.3s ease,
      transform 0.38s cubic-bezier(0.34, 1.5, 0.64, 1);
  }
  .ld-trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ld-trace rect {
    fill: none;
    stroke: var(--color-brand-400);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .ld-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px color-mix(in srgb, var(--color-brand-500) 34%, transparent);
    color: #fff;
  }
  .ld-btn:hover .ld-fill {
    transform: none;
  }
  .ld-btn:hover .ld-lab {
    transform: translateX(-9px);
  }
  .ld-btn:hover :global(.ld-arw) {
    opacity: 1;
    transform: none;
  }
  .ld-btn:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 3px;
  }

  /* ================= entrance (only under html.ab-js) ================= */
  :global(html.ab-js) .ld-aura,
  :global(html.ab-js) .ld-bracket {
    transition:
      opacity 0.7s ease calc(var(--b, 0ms) + var(--d, 0ms)),
      transform 0.9s cubic-bezier(0.34, 1.5, 0.64, 1) calc(var(--b, 0ms) + var(--d, 0ms));
  }
  :global(html.ab-js) .ld-aura {
    --d: 60ms;
  }
  :global(html.ab-js) .ld-bracket {
    --d: 1050ms;
  }

  /* The photo unmasks upward while easing out of an over-scale. */
  :global(html.ab-js) .ld-mask {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1s cubic-bezier(0.55, 0, 0.25, 1) 180ms;
  }
  :global(html.ab-js) .ld-mask :global(img) {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) 180ms;
  }

  /* Top and left run out from the corner together; right and bottom follow. */
  :global(html.ab-js) .ld-t,
  :global(html.ab-js) .ld-l {
    transform: scale(0);
    transition:
      transform 0.6s cubic-bezier(0.5, 0, 0.2, 1) 620ms,
      background 0.35s ease;
  }
  :global(html.ab-js) .ld-r,
  :global(html.ab-js) .ld-b {
    transform: scale(0);
    transition:
      transform 0.6s cubic-bezier(0.5, 0, 0.2, 1) 1000ms,
      background 0.35s ease;
  }

  :global(html.ab-js) .ld-kick,
  :global(html.ab-js) .ld-role,
  :global(html.ab-js) .ld-para,
  :global(html.ab-js) .ld-btn {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) calc(var(--b, 0ms) + var(--d, 0ms)),
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) calc(var(--b, 0ms) + var(--d, 0ms)),
      box-shadow 0.3s ease,
      color 0.3s ease;
  }
  :global(html.ab-js) .ld-name span {
    transform: translateY(105%);
    transition: transform 0.85s cubic-bezier(0.22, 0.9, 0.32, 1.05)
      calc(var(--b, 0ms) + var(--d, 0ms));
  }
  :global(html.ab-js) .ld-rule {
    transform: scaleX(0);
    transition: transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) calc(var(--b, 0ms) + var(--d, 0ms));
  }

  /* --- landed --- */
  :global(html.ab-js) .lead.in .ld-aura {
    opacity: 1;
    transform: scale(1);
  }
  :global(html.ab-js) .lead.in .ld-mask {
    clip-path: inset(0 0 0 0);
  }
  :global(html.ab-js) .lead.in .ld-mask :global(img) {
    transform: scale(1);
  }
  :global(html.ab-js) .lead.in .ld-e {
    transform: scale(1);
  }
  :global(html.ab-js) .lead.in .ld-bracket {
    opacity: 1;
    transform: none;
  }
  :global(html.ab-js) .lead.in .ld-kick,
  :global(html.ab-js) .lead.in .ld-role,
  :global(html.ab-js) .lead.in .ld-para,
  :global(html.ab-js) .lead.in .ld-btn {
    opacity: 1;
    transform: none;
  }
  :global(html.ab-js) .lead.in .ld-name span {
    transform: none;
  }
  :global(html.ab-js) .lead.in .ld-rule {
    transform: scaleX(1);
  }
  :global(html.ab-js) .lead.in .ld-trace rect {
    animation: ld-trace 0.9s cubic-bezier(0.5, 0, 0.2, 1) 1150ms forwards;
  }
  @keyframes ld-trace {
    60% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @media (max-width: 820px) {
    .ld-wrap {
      grid-template-columns: 1fr;
      gap: 1.875rem;
    }
    .ld-shot {
      max-width: 280px;
    }
    .ld-name {
      font-size: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.ab-js) .ld-aura,
    :global(html.ab-js) .ld-bracket,
    :global(html.ab-js) .ld-kick,
    :global(html.ab-js) .ld-role,
    :global(html.ab-js) .ld-para,
    :global(html.ab-js) .ld-btn {
      opacity: 1;
      transform: none;
      transition: none;
    }
    :global(html.ab-js) .ld-mask {
      clip-path: none;
      transition: none;
    }
    :global(html.ab-js) .ld-mask :global(img),
    :global(html.ab-js) .ld-name span {
      transform: none;
      transition: none;
    }
    :global(html.ab-js) .ld-rule {
      transform: scaleX(1);
      transition: none;
    }
    :global(html.ab-js) .ld-e {
      transform: scale(1);
      transition: none;
    }
    .ld-trace {
      display: none;
    }
  }
</style>
