---
import { getCollection } from 'astro:content';
import AboutAnim from '@/components/AboutAnim.astro';
import CareersForm from '@/components/CareersForm.astro';
import JobList from '@/components/JobList.astro';
import ManageBar from '@/components/ManageBar.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { offices, site } from '@/config/site';

const jobs = (await getCollection('jobs', ({ data }) => data.open)).sort(
  (a, b) => b.data.postedAt.getTime() - a.data.postedAt.getTime()
);

const positions = [...jobs.map((j) => j.data.title), 'Training / Internship Program', 'Other'];

const india = offices.find((o) => o.id === 'kollam')!;

// JobPosting markup makes these roles eligible for the Google Jobs experience.
const jsonLd = jobs.map((job) => ({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.data.title,
  description: job.data.summary,
  datePosted: job.data.postedAt.toISOString().slice(0, 10),
  employmentType: job.data.employmentType,
  hiringOrganization: { '@id': `${site.url}/#organization` },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: india.street,
      addressLocality: india.locality,
      addressRegion: india.region,
      postalCode: india.postalCode,
      addressCountry: india.countryCode,
    },
  },
  directApply: true,
  url: `${site.url}/careers#apply`,
}));
---

<BaseLayout
  title="Careers"
  description="Open roles at Alphalize — Odoo Developer, Frontend Developer and System Administrator in Kollam, Kerala. Apply with your CV."
  jsonLd={jsonLd}
>
  <AboutAnim />

  <PageHero
    anim
    eyebrow="Careers"
    title="Job opportunities"
    lead="We are a small team delivering ERP and business intelligence work for clients in two countries. That means real ownership early — and code that goes in front of people who depend on it."
  />

  <div class="container-page pt-10">
    <ManageBar scope="Job drafts" keys={['alphalize:jobs']} applications />
  </div>

  <JobList />

  {/* Application form. On <AboutAnim> rather than <Reveal>, like the rest of
      the page — the two engines cannot drive the same element. */}
  <section class="cc-surface border-brand-100 border-t py-16 lg:py-20" data-ab>
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <CareersForm positions={positions} />
      </div>
    </div>
  </section>
</BaseLayout>
