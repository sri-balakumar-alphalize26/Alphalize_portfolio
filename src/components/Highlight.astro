---
/**
 * Odoo highlights one word of a heading in an accent colour
 * (`<h1>Scale your brand <span class="text-o-color-7">online</span></h1>`).
 * We use the Odoo purple against blue headings.
 *
 * `underline` adds Odoo's hand-drawn brush stroke beneath the word.
 */
interface Props {
  /** Draw the brush underline under the word. */
  underline?: boolean;
  class?: string;
}

const { underline = false, class: className } = Astro.props;
---

{
  underline ? (
    <span class:list={['relative inline-block whitespace-nowrap text-plum-600', className]}>
      <span class="relative z-10"><slot /></span>
      <svg
        class="absolute -bottom-1 left-0 z-0 h-[0.38em] w-full text-plum-300"
        viewBox="0 0 200 14"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 9.5C38 4.2 92 2.4 197 5.6"
          stroke="currentColor"
          stroke-width="5"
          stroke-linecap="round"
        />
      </svg>
    </span>
  ) : (
    <span class:list={['text-plum-600', className]}>
      <slot />
    </span>
  )
}
