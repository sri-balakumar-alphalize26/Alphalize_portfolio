---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '@/assets/brand/logo.png';
import { contact, nav } from '@/config/site';
import Icon from './Icon.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<!-- Utility bar: contact details that were buried in the old off-canvas panel. -->
<div class="hidden bg-brand-900 text-brand-200 lg:block">
  <div class="container-page flex h-9 items-center justify-between text-xs">
    <p>ERP, business intelligence and custom software — Clearwater, FL &amp; Kollam, Kerala</p>
    <div class="flex items-center gap-6">
      <a class="flex items-center gap-1.5 hover:text-white" href={contact.phoneHref}>
        <Icon name="phone" class="size-3.5" />
        {contact.phone}
      </a>
      <a
        class="flex items-center gap-1.5 hover:text-white"
        href={`mailto:${contact.emailUser}@${contact.emailDomain}`}
      >
        <Icon name="mail" class="size-3.5" />
        {contact.emailUser}@{contact.emailDomain}
      </a>
    </div>
  </div>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-brand-100/70 bg-white/85 backdrop-blur-md transition-shadow data-[stuck]:shadow-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="shrink-0" aria-label="Alphalize — home">
      <Image
        src={logo}
        alt="Alphalize"
        widths={[180, 360]}
        sizes="180px"
        class="h-8 w-auto lg:h-9"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) =>
            item.hasChildren ? (
              <li class="group relative">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-1 rounded-[--radius-btn] px-3 py-2 text-sm font-medium transition-colors',
                    isActive(item.href)
                      ? 'text-plum-600'
                      : 'text-heading hover:text-plum-600',
                  ]}
                >
                  {item.label}
                  <Icon
                    name="chevron-down"
                    class="size-4 transition-transform group-hover:rotate-180"
                  />
                </a>
                <!--
                  CSS-only dropdown: hover opens it, and focus-within keeps it
                  open for keyboard users tabbing through the links.
                -->
                <div
                  class="invisible absolute left-1/2 top-full w-72 -translate-x-1/2 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
                >
                  <ul
                    class="overflow-hidden rounded-[--radius-card] border border-brand-100 bg-white p-2 shadow-[--shadow-lift]"
                  >
                    {
                      services.map((s) => (
                        <li>
                          <a
                            href={`/services/${s.id}`}
                            class="flex items-start gap-3 rounded-[--radius-btn] px-3 py-2.5 transition-colors hover:bg-plum-50"
                          >
                            <Icon name={s.data.icon} class="mt-0.5 size-4 text-plum-600" />
                            <span class="text-sm font-medium text-ink">{s.data.title}</span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-[--radius-btn] px-3 py-2 text-sm font-medium transition-colors',
                    isActive(item.href) ? 'text-plum-600' : 'text-heading hover:text-plum-600',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact"
        class="btn btn-primary hidden sm:inline-flex"
      >
        Get a consultation
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="-mr-2 inline-flex size-11 items-center justify-center rounded-md text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" hidden class="border-t border-brand-100 bg-white lg:hidden">
    <nav class="container-page py-4" aria-label="Mobile">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-[--radius-btn] px-3 py-3 text-base font-medium',
                  isActive(item.href) ? 'bg-plum-50 text-plum-600' : 'text-heading',
                ]}
              >
                {item.label}
              </a>
              {item.hasChildren && (
                <ul class="mb-2 ml-3 space-y-0.5 border-l border-brand-100 pl-3">
                  {services.map((s) => (
                    <li>
                      <a
                        href={`/services/${s.id}`}
                        class="block rounded-md px-3 py-2 text-sm text-muted"
                      >
                        {s.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <a
        href="/contact"
        class="btn btn-primary mt-3 w-full"
      >
        Get a consultation
      </a>
      <div class="mt-4 space-y-2 border-t border-brand-100 pt-4 text-sm text-muted">
        <a class="flex items-center gap-2" href={contact.phoneHref}>
          <Icon name="phone" class="size-4 text-brand-600" />
          {contact.phone}
        </a>
        <a
          class="flex items-center gap-2"
          href={`mailto:${contact.emailUser}@${contact.emailDomain}`}
        >
          <Icon name="mail" class="size-4 text-brand-600" />
          {contact.emailUser}@{contact.emailDomain}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile drawer + sticky-shadow. Re-bound on every view transition via
  // astro:page-load, which also fires on the initial load.
  function initHeader() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const header = document.getElementById('site-header');
    if (!toggle || !menu || !header) return;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      const label = toggle.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    // Close on Escape so keyboard users are never trapped in the drawer.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Drop the drawer if the viewport grows past the lg breakpoint.
    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });

    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute('data-stuck', '');
      else header.removeAttribute('data-stuck');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
