---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '@/assets/brand/logo.png';
import { contact, legalNav, offices, site, socials } from '@/config/site';
import Icon from './Icon.astro';

/**
 * Site footer.
 *
 * Link hover is switchable with the `hover` prop, and the treatments combine
 * (`hover="dim spotlight"`):
 *   underline  plum→brand underline wipes in            (default)
 *   dim        siblings fade back, the hovered one lifts
 *   arrow      link slides right, an arrow slides in behind it
 *   dot        a dot pops in beside the link, text shifts
 *   column     hovering a column lifts it and recedes the others
 *   spotlight  a glow follows the pointer — the only one needing JS
 *
 * Phone and email copy to the clipboard, and a back-to-top button appears once
 * the page has scrolled. Entrance comes from <AboutAnim> where it is present;
 * without it the footer simply renders, since every hidden state is guarded
 * behind `html.ab-js`.
 */
interface Props {
  hover?: string;
}

const { hover = 'underline' } = Astro.props;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const email = `${contact.emailUser}@${contact.emailDomain}`;
---

<footer
  class:list={['ft bg-brand-950 text-brand-100 mt-24', hover.split(' ').map((h) => `h-${h}`)]}
  data-ab
>
  <span class="ft-glow" aria-hidden="true"></span>

  <div class="container-page py-14 lg:py-18">
    <div class="ft-grid grid gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Brand -->
      <div class="ft-col ab lg:col-span-4" style="--d:0ms">
        <Image
          src={logo}
          alt="Alphalize"
          widths={[180, 360]}
          sizes="180px"
          class="h-9 w-auto brightness-0 invert"
          loading="lazy"
        />
        <p class="text-brand-200 mt-4 max-w-sm text-sm leading-relaxed">
          {site.description}
        </p>
        <ul class="mt-6 flex gap-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="ft-social hover:bg-brand-600 flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors"
                >
                  <Icon name={s.icon} class="size-4" label={s.name} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <nav class="ft-col ab lg:col-span-3" style="--d:120ms" aria-label="Services">
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.id}`} class="text-brand-200">
                  {s.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Company -->
      <nav class="ft-col ab lg:col-span-2" style="--d:220ms" aria-label="Company">
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about" class="text-brand-200">About</a></li>
          <li><a href="/careers" class="text-brand-200">Careers</a></li>
          <li><a href="/contact" class="text-brand-200">Contact</a></li>
          {
            legalNav.map((l) => (
              <li>
                <a href={l.href} class="text-brand-200">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Offices -->
      <div class="ft-col ab lg:col-span-3" style="--d:320ms">
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Offices</h2>
        <ul class="mt-4 space-y-4 text-sm">
          {
            offices.map((o) => (
              <li class="flex gap-2.5">
                <Icon name="pin" class="text-brand-400 mt-0.5 size-4 shrink-0" />
                <span class="text-brand-200">
                  <span class="block font-medium text-white">{o.label}</span>
                  {o.street}, {o.locality}, {o.region} {o.postalCode}
                </span>
              </li>
            ))
          }
          <li class="ft-cp flex gap-2.5" data-copy={contact.phone}>
            <Icon name="phone" class="text-brand-400 mt-0.5 size-4 shrink-0" />
            <a href={contact.phoneHref} class="text-brand-200">{contact.phone}</a>
            <button type="button" class="ft-copy" aria-label="Copy phone number">
              <Icon name="copy" class="ft-ci size-3.5" />
              <Icon name="check" draw class="ft-co size-3.5" />
            </button>
          </li>
          <li class="ft-cp flex gap-2.5" data-copy={email}>
            <Icon name="mail" class="text-brand-400 mt-0.5 size-4 shrink-0" />
            <a href={`mailto:${email}`} class="text-brand-200">{email}</a>
            <button type="button" class="ft-copy" aria-label="Copy email address">
              <Icon name="copy" class="ft-ci size-3.5" />
              <Icon name="check" draw class="ft-co size-3.5" />
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="text-brand-300 ab mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
      style="--d:440ms"
    >
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p>{offices[0]?.locality}, {offices[0]?.region}</p>
    </div>
  </div>

  <button type="button" class="ft-top" id="ftTop" aria-label="Back to top">
    <Icon name="chevron-down" class="size-4 rotate-180" />
  </button>
</footer>

<script>
  function initFooter() {
    const ft = document.querySelector<HTMLElement>('footer.ft');
    if (!ft) return;

    // The spotlight variant is the only one that needs the pointer position.
    if (ft.classList.contains('h-spotlight') && !ft.dataset.glowWired) {
      ft.dataset.glowWired = '1';
      ft.addEventListener('pointermove', (e) => {
        const r = ft.getBoundingClientRect();
        ft.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        ft.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
    }

    ft.querySelectorAll<HTMLElement>('.ft-cp').forEach((row) => {
      const btn = row.querySelector<HTMLButtonElement>('.ft-copy');
      const value = row.dataset.copy;
      if (!btn || !value || row.dataset.wired) return;
      row.dataset.wired = '1';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          // Clipboard API needs a secure context; fall back so the button still
          // works on http:// and in older browsers.
          const ta = document.createElement('textarea');
          ta.value = value;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.append(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        row.classList.add('is-copied');
        setTimeout(() => row.classList.remove('is-copied'), 1600);
      });
    });

    const top = document.getElementById('ftTop');
    if (top && !top.dataset.wired) {
      top.dataset.wired = '1';
      const check = () => top.classList.toggle('on', scrollY > innerHeight * 0.8);
      addEventListener('scroll', check, { passive: true });
      check();
      top.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
    }
  }

  document.addEventListener('astro:page-load', initFooter);
  if (document.readyState !== 'loading') initFooter();
  else document.addEventListener('DOMContentLoaded', initFooter, { once: true });
</script>

<style>
  .ft {
    position: relative;
    overflow: hidden;
  }
  .ft-col a,
  .ft-col :global(a) {
    position: relative;
    transition:
      color 0.28s ease,
      opacity 0.28s ease,
      transform 0.3s cubic-bezier(0.22, 0.9, 0.32, 1.2);
  }

  /* --- underline: plum → brand wipe, the site's existing gradient --- */
  .h-underline .ft-col ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-brand-400), var(--color-plum-400));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .h-underline .ft-col ul a:hover {
    color: #fff;
  }
  .h-underline .ft-col ul a:hover::after {
    transform: scaleX(1);
  }

  /* --- dim --- */
  .h-dim .ft-col ul:hover a {
    opacity: 0.38;
  }
  .h-dim .ft-col ul a:hover {
    opacity: 1;
    color: #fff;
  }

  /* --- arrow --- */
  .h-arrow .ft-col ul a::before {
    content: '→';
    position: absolute;
    left: -15px;
    top: 0;
    opacity: 0;
    color: var(--color-brand-400);
    transform: translateX(-6px);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
  }
  .h-arrow .ft-col ul a:hover {
    color: #fff;
    transform: translateX(13px);
  }
  .h-arrow .ft-col ul a:hover::before {
    opacity: 1;
    transform: none;
  }

  /* --- dot --- */
  .h-dot .ft-col ul a::before {
    content: '';
    position: absolute;
    left: -13px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background: var(--color-brand-400);
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.34, 1.6, 0.64, 1);
  }
  .h-dot .ft-col ul a:hover {
    color: #fff;
    transform: translateX(11px);
  }
  .h-dot .ft-col ul a:hover::before {
    transform: scale(1);
  }

  /* --- column --- */
  .h-column .ft-grid:hover > * {
    opacity: 0.5;
    transition: opacity 0.35s ease;
  }
  .h-column .ft-grid > *:hover {
    opacity: 1;
  }
  .h-column .ft-col {
    position: relative;
    transition:
      transform 0.4s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      opacity 0.35s ease;
  }
  .h-column .ft-col:hover {
    transform: translateX(3px);
  }
  .h-column .ft-col a:hover {
    color: #fff;
  }

  /* --- spotlight (the only variant that needs JS) --- */
  .ft-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      circle 260px at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--color-brand-500) 16%, transparent),
      transparent 70%
    );
  }
  .h-spotlight:hover .ft-glow {
    opacity: 1;
  }
  .h-spotlight .ft-col ul a:hover {
    color: #fff;
    text-shadow: 0 0 18px color-mix(in srgb, var(--color-brand-400) 55%, transparent);
  }

  /* --- copy buttons --- */
  .ft-copy {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.125rem;
    border-radius: 4px;
    color: var(--color-brand-300);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.25s ease,
      color 0.25s ease;
  }
  .ft-cp:hover .ft-copy,
  .ft-copy:focus-visible {
    opacity: 1;
  }
  .ft-copy:hover {
    color: #fff;
  }
  .ft-copy :global(.ft-co) {
    position: absolute;
    color: var(--color-teal-500);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ft-copy :global(.ft-co path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .is-copied .ft-copy {
    opacity: 1;
  }
  .is-copied :global(.ft-ci) {
    opacity: 0;
  }
  .is-copied :global(.ft-co) {
    opacity: 1;
  }
  .is-copied :global(.ft-co path) {
    animation: ft-tick 0.4s cubic-bezier(0.55, 0, 0.35, 1) forwards;
  }
  @keyframes ft-tick {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* --- back to top --- */
  .ft-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-brand-700);
    color: #fff;
    box-shadow: var(--shadow-lift);
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      background 0.25s ease;
  }
  .ft-top.on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .ft-top:hover {
    background: var(--color-brand-600);
  }

  @media (prefers-reduced-motion: reduce) {
    .ft-col a,
    .ft-col :global(a),
    .ft-copy,
    .ft-top,
    .ft-glow {
      transition: none;
    }
    .h-underline .ft-col ul a::after,
    .h-arrow .ft-col ul a::before,
    .h-dot .ft-col ul a::before,
    .h-column .ft-col {
      transition: none;
    }
    .is-copied :global(.ft-co path) {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
