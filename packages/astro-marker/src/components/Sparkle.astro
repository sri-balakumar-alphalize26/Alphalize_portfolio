---
/**
 * <Sparkle> — hand-drawn burst lines + hearts around a block (the "Unleash" hero).
 *
 *   <Sparkle color="yellow">
 *     <Heading size="xl" align="center">Unleash<br/>your <span class="mk-ink-teal">growth potential</span></Heading>
 *   </Sparkle>
 *
 * color   named marker colour or CSS colour
 * hearts  draw the two small hearts (default true)
 */
export interface Props { color?: string; hearts?: boolean; animate?: boolean; class?: string }
const NAMED = ['yellow', 'pink', 'teal', 'blue', 'sky', 'orange', 'purple', 'green'];
const { color = 'yellow', hearts = true, animate = true, class: className = '' } = Astro.props;
const col = NAMED.includes(color) ? `var(--mk-${color})` : color;
const heart = 'M0 3 C -1 0, -5 0, -4 3 C -3 5, 0 7, 0 8 C 0 7, 3 5, 4 3 C 5 0, 1 0, 0 3 Z';
---
<div class:list={['mk-sparkle', className, { 'mk-animate': animate }]} data-mk-mark style={`--mk-stroke:${col}`}>
  <svg class="mk-sparkle__svg mk-sparkle__svg--l" viewBox="0 0 120 120" aria-hidden="true">
    <g class="mk-sparkle__rays">
      <path d="M62 84 L 66 46" style="--i:0"/>
      <path d="M48 88 L 30 60" style="--i:1"/>
      <path d="M78 86 L 90 52" style="--i:2"/>
      <path d="M36 100 L 12 96" style="--i:3"/>
      <path d="M100 96 L 108 90" style="--i:4"/>
    </g>
    {hearts && <g class="mk-sparkle__hearts">
      <path d={heart} transform="translate(22 40) rotate(-20) scale(2)" style="--i:2"/>
      <path d={heart} transform="translate(96 30) rotate(25) scale(1.8)" style="--i:3"/>
    </g>}
  </svg>
  <svg class="mk-sparkle__svg mk-sparkle__svg--r" viewBox="0 0 80 100" aria-hidden="true">
    <g class="mk-sparkle__rays">
      <path d="M20 26 L 26 50" style="--i:1"/>
      <path d="M50 20 L 44 46" style="--i:2"/>
      <path d="M8 66 L 36 66" style="--i:3"/>
      <path d="M52 72 L 40 84" style="--i:4"/>
    </g>
  </svg>
  <div class="mk-sparkle__body"><slot /></div>
</div>

<style>
  .mk-sparkle { position: relative; display: block; padding: 3.2em 2.4em 0.5em; }
  .mk-sparkle__body { position: relative; }
  .mk-sparkle__svg { position: absolute; overflow: visible; pointer-events: none; }
  .mk-sparkle__svg--l { left: 12%; top: -0.5em; width: 5.5em; height: 5.5em; }
  .mk-sparkle__svg--r { right: 8%; top: 1.2em; width: 3.6em; height: 4.5em; }
  .mk-sparkle__rays path { fill: none; stroke: var(--mk-stroke); stroke-width: 5; stroke-linecap: round; }
  .mk-sparkle__hearts path { fill: var(--mk-stroke); }
  .mk-animate .mk-sparkle__rays path, .mk-animate .mk-sparkle__hearts path {
    transform-box: fill-box; transform-origin: center; transform: scale(0); opacity: 0;
    transition: transform .45s cubic-bezier(.2,1.4,.4,1), opacity .2s; transition-delay: calc(var(--i) * 90ms + 150ms);
  }
  .mk-animate.is-in .mk-sparkle__rays path, .mk-animate.is-in .mk-sparkle__hearts path { transform: scale(1); opacity: 1; }
</style>
