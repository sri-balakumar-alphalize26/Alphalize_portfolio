---
import { site } from '@/config/site';
import { localeHref, splitLocale } from '@/i18n/paths';
import { defaultLocale, liveLocales, localeLabels, type Locale } from '@/i18n/locales';

interface Props {
  title: string;
  description: string;
  /** Omit to derive from Astro.url — set only for canonicalising odd routes. */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD objects to embed. Serialised as-is. */
  jsonLd?: Record<string, unknown>[];
  /**
   * Site-root-absolute path to a 1200x630 share image, e.g. '/og/ceo.png'.
   * Omit for the default card.
   */
  ogImagePath?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  ogImagePath,
} = Astro.props;

/**
 * `cleanPath` is locale-free: the prefix comes off here and goes back on below.
 * That is what lets one page emit an alternate for each locale from the same
 * path, and it is why `canonicalPath`, when a caller passes one, must also be
 * locale-free.
 *
 * It is extension-free too — `build.format: 'file'` makes the build-time
 * pathname `/en/about.html` while Cloudflare serves it at `/en/about` and the
 * sitemap lists that, so every signal has to agree.
 */
const { path: cleanPath } = splitLocale(canonicalPath ?? Astro.url.pathname);
const { locale } = Astro.locals;

/** The absolute URL of this page in a given locale. */
const urlFor = (l: Locale) => new URL(localeHref(l, cleanPath), site.url).href;

const canonical = urlFor(locale);

/**
 * Alternates cover the locales that actually have pages — `liveLocales`, not
 * all nine. Pointing hreflang at a URL that 404s is worse than omitting it.
 *
 * The set includes this page itself: Google requires every member of an
 * alternate set to reference all of them, itself included, and drops the whole
 * set if one does not.
 */
const alternates = liveLocales.map((l) => ({
  hreflang: localeLabels[l].hreflang,
  href: urlFor(l),
}));

const isHome = cleanPath === '/';
// Home keeps the bare brand name; every other page is suffixed.
const fullTitle = isHome ? title : `${title} | ${site.name}`;
/**
 * Every page shared the same card until now. A page may pass its own, but the
 * 1200x630 below is asserted rather than measured, so an override has to be
 * that size — which is why this takes a path to an image we control and not an
 * arbitrary URL.
 */
const ogImage = new URL(ogImagePath ?? '/og-default.png', site.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  /*
    Suppressed under noindex: the 404 and the owner-only applications inbox are
    not members of any alternate set, and advertising them as translations of
    each other would be wrong.
  */
  !noindex && (
    <>
      {alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))}
      {/* Where a reader whose language we do not publish should land. The
          English edition — a static site on Cloudflare assets has nothing to
          negotiate with, so this is a destination, not a gateway. */}
      <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
    </>
  )
}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeLabels[locale].ogLocale} />
{
  liveLocales
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={localeLabels[l].ogLocale} />)
}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  /*
    `<` is escaped, for the same reason the i18n client payload escapes it in
    BaseLayout: these blocks carry translated strings, and one containing
    "</script>" would end the block early and spill the rest of the JSON into
    the document as markup. JSON.stringify does not escape it, and a valid
    JSON-LD document is unchanged by the substitution — < is just `<`.
  */
  jsonLd.map((block) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(block).replace(/</g, '\\u003c')}
      is:inline
    />
  ))
}
