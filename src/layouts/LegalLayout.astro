---
import PageHero from '@/components/PageHero.astro';
import BaseLayout from './BaseLayout.astro';
import { legalNav } from '@/config/site';
import { stripMarks } from '@/components/marks';
import { localeHref, splitLocale } from '@/i18n/paths';

interface Props {
  /** Phrases to wrap in a marker stroke are marked inline — see marks.ts. */
  title: string;
  description: string;
  updated: string;
  /** 'en' when this locale has no translation — marks the prose, not the page. */
  lang?: string;
}

const { title, description, updated, lang } = Astro.props;
// The hero draws the strokes; <title> and og:title want the words only.
const plainTitle = stripMarks(title);
// Locale-free and extension-free, so it can be compared against the plain
// hrefs in legalNav. Without either step no sidebar link is ever marked
// current: the pathname here is "/en/legal/privacy-policy.html".
const { path } = splitLocale(Astro.url.pathname);

/** Prefix an internal path with this page's locale. */
const { locale, t } = Astro.locals;
const loc = (to: string) => localeHref(locale, to);
---

<BaseLayout title={plainTitle} description={description}>
  <PageHero title={title} eyebrow="Legal" />

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <article class="lg:col-span-8">
      <p class="text-muted text-xs">Last updated: {updated}</p>
      <div class="prose-content mt-4" lang={lang} dir={lang ? 'ltr' : undefined}>
        <slot />
      </div>
    </article>

    <aside class="lg:col-span-4">
      <nav class="lg:sticky lg:top-28" aria-label="Legal pages">
        <h2 class="text-ink text-sm font-semibold tracking-wider uppercase">Legal</h2>
        <ul class="divide-brand-100 mt-3 divide-y">
          {
            legalNav.map((l) => (
              <li>
                <a
                  href={loc(l.href)}
                  aria-current={path === l.href ? 'page' : undefined}
                  class:list={[
                    'block py-2.5 text-sm transition-colors',
                    path === l.href
                      ? 'text-brand-700 font-semibold'
                      : 'text-muted hover:text-brand-700',
                  ]}
                >
                  {t(l.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>
