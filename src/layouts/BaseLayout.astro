---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Seo from '@/components/Seo.astro';
import ContactSync from '@/components/ContactSync.astro';
import IconDefs from '@/components/IconDefs.astro';
import SplashScreen from '@/components/SplashScreen.astro';
import { contact, offices, site } from '@/config/site';
import { localeLabels } from '@/i18n/locales';
import { scriptFonts } from '@/styles/fonts-per-script';
import inter400 from '@alphalize/astro-marker/fonts/inter-latin-400-normal.woff2?url';
import caveat700 from '@alphalize/astro-marker/fonts/caveat-latin-700-normal.woff2?url';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, canonicalPath, ogType, noindex, jsonLd = [] } = Astro.props;

// Sitewide Organization graph — emitted once, on every page.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.legalName,
  url: site.url,
  logo: `${site.url}/favicon.png`,
  email: `${contact.emailUser}@${contact.emailDomain}`,
  telephone: contact.phone,
  description: site.description,
  address: offices.map((o) => ({
    '@type': 'PostalAddress',
    streetAddress: o.street,
    addressLocality: o.locality,
    addressRegion: o.region,
    postalCode: o.postalCode,
    addressCountry: o.countryCode,
  })),
};
/* Set by src/middleware.ts, from the [locale] route segment. */
const { locale, t } = Astro.locals;

/**
 * Dev-only direction override: `?dir=rtl` on any page renders it mirrored.
 *
 * The RTL work is ~106 physical CSS declarations plus ~125 direction-bearing
 * transforms spread across sixty-odd scoped <style> blocks, and none of it can
 * be looked at until something renders right-to-left. This makes every page
 * inspectable today, with no Arabic catalogue, no translated content and no
 * routing — which is what lets the whole RTL pass be built and reviewed before
 * a single Arabic string exists.
 *
 * Gated on import.meta.env.DEV, so it is stripped from the production build and
 * cannot be triggered by a query string on the live site.
 */
const forcedDir = import.meta.env.DEV ? Astro.url.searchParams.get('dir') : null;
const dir = forcedDir === 'rtl' || forcedDir === 'ltr' ? forcedDir : localeLabels[locale].dir;
---

<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#004b80" />

    <!-- Fonts are self-hosted (packages/astro-marker); preload the two above-the-fold faces. -->
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={caveat700} as="font" type="font/woff2" crossorigin />

    {
      /*
        The locale's own script faces, linked only on pages that need them.
        A French visitor gets Latin-ext and nothing more; the Arabic, Tamil and
        Malayalam labels in the language picker render in whatever the OS has,
        which costs nothing and looks right. See styles/fonts-per-script.ts for
        why this cannot be one stylesheet.
      */
      (scriptFonts[locale] ?? []).map((href) => <link rel="stylesheet" href={href} />)
    }

    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogType={ogType}
      noindex={noindex}
      jsonLd={[organization, ...jsonLd]}
    />

    {
      /*
      Strings for code that runs in the browser, read by i18n/client.ts.
      Inlined rather than fetched: a client script has no way to know which of
      nine catalogues to ask for without shipping all nine, and this namespace
      is about a dozen strings. No request, no flash.

      `<` is escaped because a translated string containing "</script>" would
      otherwise end the block early.
    */
    }
    <script
      type="application/json"
      id="i18n-client"
      is:inline
      set:html={JSON.stringify(t('client')).replace(/</g, '\\u003c')}
    />

    <!-- Cross-fade page transitions. Static HTML, SPA-like navigation. -->
    <ClientRouter />
  </head>

  <body class="flex min-h-dvh flex-col">
    <IconDefs />
    <SplashScreen />
    <ContactSync />

    <a
      href="#main"
      class="focus:bg-brand-700 sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      {t('common.skipToContent')}
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    {
      /*
        Navigation feedback. The splash used to cover the screen on every
        in-site click, which was a second of white between a tap and the page —
        so it now shows on arrival only. This is what replaces it: a 2px bar,
        no layout shift, and no minimum display time.
      */
    }
    <div id="nav-progress" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  #nav-progress {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 300;
    height: 2px;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-plum-600));
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
  }
  :global([dir='rtl']) #nav-progress {
    transform-origin: right center;
  }
  /* Creeps toward 90% while the page is fetched — it cannot know real progress,
     so it eases out and waits rather than pretending to finish. */
  #nav-progress.is-loading {
    opacity: 1;
    transform: scaleX(0.9);
    transition:
      transform 8s cubic-bezier(0.1, 0.8, 0.2, 1),
      opacity 0.1s;
  }
  #nav-progress.is-done {
    opacity: 0;
    transform: scaleX(1);
    transition:
      transform 0.2s ease-out,
      opacity 0.3s ease 0.15s;
  }
  @media (prefers-reduced-motion: reduce) {
    #nav-progress {
      transition: none !important;
    }
  }
</style>

<script>
  /**
   * A navigation that resolves quickly should show nothing at all — a bar that
   * flashes on every click is worse than no bar. So it waits 150ms before
   * appearing, and a navigation that finishes first never shows one.
   */
  const SHOW_AFTER_MS = 150;

  const bar = () => document.getElementById('nav-progress');
  let showTimer: ReturnType<typeof setTimeout> | undefined;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  function start() {
    clearTimeout(showTimer);
    clearTimeout(hideTimer);
    showTimer = setTimeout(() => {
      const el = bar();
      if (!el) return;
      el.classList.remove('is-done');
      // Reflow, or removing and adding the class in one frame is not a change
      // the browser ever sees and the bar never restarts.
      void el.offsetWidth;
      el.classList.add('is-loading');
    }, SHOW_AFTER_MS);
  }

  function done() {
    clearTimeout(showTimer);
    const el = bar();
    if (!el || !el.classList.contains('is-loading')) return;
    el.classList.remove('is-loading');
    el.classList.add('is-done');
    hideTimer = setTimeout(() => el.classList.remove('is-done'), 500);
  }

  document.addEventListener('astro:before-preparation', start);
  document.addEventListener('astro:page-load', done);
</script>
