---
/**
 * The `?manage=1` control bar and its passcode dialog. Renders nothing without
 * that query string — a plain URL stays a visitor page.
 *
 * The passcode is checked by /api/manage, never here: the session it opens also
 * guards the applications inbox, which carries candidates' personal data. This
 * component only decides which controls appear.
 */
interface Props {
  /** What the drafts on this page are, for the warning line. */
  scope?: string;
  /** localStorage keys this page's "Discard drafts" should clear. */
  keys?: string[];
  /** Show the link to the applications inbox. */
  applications?: boolean;
}

const { scope = 'Edits', keys = [], applications = false } = Astro.props;
---

{/* Native <dialog>: real focus trapping, Escape handling and an inert page
    behind it, none of which is worth hand-rolling. */}
<dialog class="mb-dialog" data-manage-dialog>
  <form class="mb-dialog-in" data-manage-lock>
    <h2 class="mb-dialog-h">Manage mode</h2>
    <p class="mb-dialog-p">
      Enter the passcode to edit this page. The session is checked on the server and lasts for the
      configured auto-lock period.
    </p>

    <label class="sr-only" for="mb-pass">Passcode</label>
    <input
      id="mb-pass"
      type="password"
      name="passcode"
      placeholder="Passcode"
      autocomplete="current-password"
      required
    />
    <p class="mb-dialog-err" data-manage-error></p>

    <div class="mb-dialog-actions">
      <button type="button" class="btn btn-outline mb-btn" data-manage-cancel>Cancel</button>
      <button type="submit" class="btn btn-primary mb-btn">Unlock</button>
    </div>
  </form>
</dialog>

<div class="mb" data-manage-bar data-keys={keys.join(',')} hidden>
  <div class="mb-head">
    <p class="mb-title">Manage mode</p>
    <span class="mb-left" data-manage-left></span>
  </div>

  <div class="mb-unlocked" data-manage-unlocked hidden>
    <slot />

    <div class="mb-row mb-actions">
      {
        applications && (
          <a href="/careers/applications" class="btn btn-primary mb-btn">
            Applications
          </a>
        )
      }
      <button type="button" class="btn btn-outline mb-btn" data-manage-settings>Settings</button>
      <button type="button" class="btn btn-outline mb-btn" data-manage-discard>
        Discard drafts
      </button>
      <button type="button" class="btn btn-outline mb-btn" data-manage-lockout>Lock</button>
    </div>

    <div class="mb-settings" data-manage-settings-panel hidden>
      <form class="mb-set" data-manage-passcode-form>
        <p class="mb-set-h">Change passcode</p>
        <input type="password" name="current" placeholder="Current" autocomplete="current-password" required />
        <input type="password" name="next" placeholder="New" autocomplete="new-password" required />
        <input type="password" name="confirm" placeholder="Confirm" autocomplete="new-password" required />
        <button type="submit" class="btn btn-primary mb-btn">Save</button>
      </form>

      <form class="mb-set" data-manage-hours-form>
        <p class="mb-set-h">Auto-lock after</p>
        <input type="number" name="hours" min="1" max="72" step="1" required />
        <span class="mb-set-unit">hours</span>
        <button type="submit" class="btn btn-primary mb-btn">Save</button>
      </form>

      <p class="mb-set-msg" data-manage-settings-msg></p>
    </div>
  </div>

  <p class="mb-warn">
    {scope} are saved in <strong>this browser only</strong> and shown only while <code>?manage=1</code>
    is in the address. Visitors, Google Jobs and the application form all still use the published
    content from the repository — publishing a change still means editing the source and redeploying.
  </p>
</div>

<script>
  import { inManageMode, manageAction, refreshStatus, status, writeRaw } from './manage';

  const UNLOCK_MESSAGES: Record<string, string> = {
    wrong: 'That passcode is not right.',
    throttled: 'Too many attempts. Wait a minute and try again.',
    unset: 'No passcode is configured on the server (MANAGE_PASSCODE).',
    network: 'Could not reach the server.',
  };

  const CHANGE_MESSAGES: Record<string, string> = {
    'wrong-current': 'The current passcode is not right.',
    'too-short': 'The new passcode is too short — four characters minimum.',
    mismatch: 'The two new passcodes do not match.',
    locked: 'That session has expired. Reload and unlock again.',
    unset: 'Passcode storage is not configured on the server.',
    network: 'Could not reach the server.',
  };

  /**
   * Leave manage mode by loading the plain URL.
   *
   * A reload rather than just closing the dialog, on purpose: drafts are
   * applied as soon as `?manage=1` is present, so merely hiding the bar would
   * leave edited text on screen while claiming not to be in manage mode.
   * `replace` so Back does not drop the visitor into the manage URL.
   */
  function leaveManageMode() {
    const url = new URL(location.href);
    url.searchParams.delete('manage');
    location.replace(url.pathname + url.search + url.hash);
  }

  async function initManageBar() {
    const bar = document.querySelector<HTMLElement>('[data-manage-bar]');
    if (!bar || !inManageMode()) return;

    const dialog = document.querySelector<HTMLDialogElement>('[data-manage-dialog]');
    const lockForm = dialog?.querySelector<HTMLFormElement>('[data-manage-lock]');
    const error = dialog?.querySelector<HTMLElement>('[data-manage-error]');
    const cancel = dialog?.querySelector<HTMLButtonElement>('[data-manage-cancel]');
    const unlocked = bar.querySelector<HTMLElement>('[data-manage-unlocked]');
    const left = bar.querySelector<HTMLElement>('[data-manage-left]');
    const settingsBtn = bar.querySelector<HTMLButtonElement>('[data-manage-settings]');
    const settings = bar.querySelector<HTMLElement>('[data-manage-settings-panel]');
    const settingsMsg = bar.querySelector<HTMLElement>('[data-manage-settings-msg]');
    const passcodeForm = bar.querySelector<HTMLFormElement>('[data-manage-passcode-form]');
    const hoursForm = bar.querySelector<HTMLFormElement>('[data-manage-hours-form]');
    if (!dialog || !lockForm || !unlocked) return;

    const render = async () => {
      const { unlocked: open, sessionHours } = await status();
      bar.hidden = !open;
      unlocked.hidden = !open;
      if (left) left.textContent = open ? `Auto-locks after ${sessionHours}h` : '';
      // `.value`, not setAttribute: the attribute is only the DEFAULT, so once
      // the field has been typed in the displayed value would stop updating.
      const hoursInput = hoursForm?.querySelector<HTMLInputElement>('input');
      if (hoursInput) hoursInput.value = String(sessionHours);
      if (!open && !dialog.open) dialog.showModal();
      if (open && dialog.open) dialog.close();
    };

    if (!bar.dataset.wired) {
      bar.dataset.wired = '1';

      lockForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const passcode = new FormData(lockForm).get('passcode')?.toString() ?? '';
        const result = await manageAction('unlock', { passcode });
        if (result.ok !== true) {
          if (error) error.textContent = UNLOCK_MESSAGES[String(result.outcome)] ?? 'Unlock failed.';
          lockForm.querySelector('input')?.select();
          return;
        }
        if (error) error.textContent = '';
        lockForm.reset();
        await refreshStatus();
        await render();
        // Let the page wire up its own editing affordances.
        document.dispatchEvent(new CustomEvent('manage:unlocked'));
      });

      cancel?.addEventListener('click', leaveManageMode);
      // Escape fires `cancel` on a modal dialog: treat it as Cancel, or the
      // dialog closes and leaves an unusable half-manage page.
      dialog.addEventListener('cancel', (e) => {
        e.preventDefault();
        leaveManageMode();
      });

      settingsBtn?.addEventListener('click', () => {
        if (settings) settings.hidden = !settings.hidden;
      });

      passcodeForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(passcodeForm);
        const result = await manageAction('change-passcode', {
          current: data.get('current')?.toString() ?? '',
          next: data.get('next')?.toString() ?? '',
          confirm: data.get('confirm')?.toString() ?? '',
        });
        if (settingsMsg) {
          settingsMsg.textContent =
            result.ok === true
              ? 'Passcode changed. Other devices have been signed out.'
              : (CHANGE_MESSAGES[String(result.outcome)] ?? 'Could not change the passcode.');
        }
        if (result.ok === true) passcodeForm.reset();
      });

      hoursForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const hours = new FormData(hoursForm).get('hours')?.toString() ?? '';
        const result = await manageAction('set-hours', { hours });
        if (settingsMsg) {
          settingsMsg.textContent =
            result.ok === true
              ? `Auto-lock set to ${result.sessionHours} hours.`
              : 'Auto-lock must be between 1 and 72 hours.';
        }
        if (result.ok === true) {
          await refreshStatus();
          await render();
        }
      });

      bar.querySelector<HTMLButtonElement>('[data-manage-lockout]')?.addEventListener(
        'click',
        async () => {
          await manageAction('lock');
          leaveManageMode();
        }
      );

      bar.querySelector<HTMLButtonElement>('[data-manage-discard]')?.addEventListener(
        'click',
        () => {
          for (const key of (bar.dataset.keys ?? '').split(',').filter(Boolean)) {
            writeRaw(key, null);
          }
          location.reload();
        }
      );
    }

    await render();
  }

  document.addEventListener('astro:page-load', initManageBar);
  if (document.readyState !== 'loading') void initManageBar();
  else document.addEventListener('DOMContentLoaded', () => void initManageBar(), { once: true });
</script>

<style>
  .mb[hidden] {
    display: none;
  }
  .mb {
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--color-brand-300);
    border-radius: var(--radius-card);
    background: var(--color-brand-50);
  }
  .mb-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .mb-title {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .mb-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mb-row[hidden],
  .mb-unlocked[hidden],
  .mb-settings[hidden] {
    display: none;
  }
  .mb-actions {
    align-items: center;
    margin-top: 0.625rem;
  }
  .mb-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }

  .mb-settings {
    margin-top: 0.875rem;
    padding-top: 0.875rem;
    border-top: 1px dashed var(--color-brand-200);
  }
  .mb-set {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
  }
  .mb-set-h {
    margin: 0;
    flex: 0 0 100%;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .mb-set-unit {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .mb :global(input) {
    min-width: 0;
    flex: 1 1 8rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-brand-200);
    border-radius: var(--radius-btn);
    background: #fff;
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .mb-set :global(input[type='number']) {
    flex: 0 0 5rem;
  }
  .mb-set-msg:empty {
    display: none;
  }
  .mb-left,
  .mb-set-msg,
  .mb-warn {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .mb-set-msg,
  .mb-warn {
    margin: 0.625rem 0 0;
  }
  .mb-warn code {
    font-size: 0.6875rem;
  }

  /* --- passcode dialog --- */
  .mb-dialog {
    /* Centred explicitly rather than relying on the UA default, which pins the
       dialog to the top once a width is set. `inset: 0` + `margin: auto` needs
       `height: fit-content`, or the box stretches and the centring is lost. */
    position: fixed;
    inset: 0;
    margin: auto;
    height: fit-content;
    max-height: calc(100dvh - 2rem);
    max-width: 26rem;
    width: calc(100% - 2rem);
    padding: 0;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
    color: var(--color-ink);
  }
  .mb-dialog::backdrop {
    background: rgb(4 30 57 / 0.45);
    backdrop-filter: blur(2px);
  }
  .mb-dialog-in {
    padding: 1.5rem;
  }
  .mb-dialog-h {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .mb-dialog-p {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .mb-dialog-in :global(input) {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-brand-200);
    border-radius: var(--radius-btn);
    background: #fff;
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .mb-dialog-err {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .mb-dialog-err:empty {
    display: none;
  }
  .mb-dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
</style>
