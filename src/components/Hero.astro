---
import { Arrow, Heading, Marker, Note } from '@alphalize/astro-marker';
import { getCollection } from 'astro:content';
import AppOrbit from './AppOrbit.astro';
import Icon from './Icon.astro';

/**
 * Odoo-style hero: light background, one large handwriting heading with a
 * single marker-highlighted phrase, a light lead paragraph, two squared
 * buttons with a hand-drawn aside, and the app orbit on the right.
 *
 * Replaces the old 4-slide Embla carousel — the only script is the
 * marker's IntersectionObserver; the orbit is pure CSS.
 */
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---

<section class="cc-white relative isolate overflow-hidden">
  <!-- Soft tinted wash, Odoo keeps heroes light rather than dark. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_70%_at_15%_0%,var(--color-brand-50),transparent_60%),radial-gradient(ellipse_50%_60%_at_95%_20%,var(--color-plum-50),transparent_55%)]"
  >
  </div>

  <div class="container-page py-16 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow">Odoo ERP partners</p>

        <Heading as="h1" size="xl" class="mt-3">
          Run your whole business <Marker type="highlight" color="yellow">on one system</Marker>
        </Heading>

        <p class="lead text-muted mt-6 max-w-xl">
          Alphalize builds and implements Odoo ERP, business intelligence and the mobile, desktop
          and IoT software around it — so your counter, your warehouse and your back office all see
          the same numbers.
        </p>

        <div class="mt-9 flex flex-wrap items-start gap-3">
          <a href="/contact" class="btn btn-primary">
            Talk to us
            <Icon name="arrow-right" class="size-4" />
          </a>
          <a href="/services" class="btn btn-outline text-heading"> Explore services </a>

          <!-- Odoo's handwritten aside beside the CTAs ("… / month for ALL apps"). -->
          <span class="ml-1 hidden items-start sm:flex">
            <Arrow variant="curve-down-right" color="purple" size={44} delay={700} />
            <Note color="purple" rotate={-6} size="1.25rem" align="left" class="mt-5">
              24/7 support included
            </Note>
          </span>
        </div>

        <p class="text-muted mt-6 text-sm">
          Offices in Clearwater, Florida and Kollam, Kerala &middot; 24/7 support
        </p>
      </div>

      <!-- Product visual: the app line-up orbiting the brand mark. -->
      <div class="lg:col-span-6">
        <AppOrbit apps={apps} class="mx-auto max-w-[36rem]" />
        <p class="mt-3 text-center">
          <a
            href="/services/mobile-app-development#apps"
            class="text-brand-700 hover:text-plum-600 inline-flex items-center gap-1.5 text-sm font-medium"
          >
            All {apps.length} apps
            <Icon name="arrow-right" class="size-4" />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
