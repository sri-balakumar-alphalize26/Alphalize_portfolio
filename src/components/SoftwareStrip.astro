---
import { getCollection } from 'astro:content';
import AppMarquee from './AppMarquee.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import Reveal from './Reveal.astro';
import { localeHref } from '@/i18n/paths';
import SectionHeading from './SectionHeading.astro';

/**
 * Homepage "software we build" strip: two tiles deep-linking into the
 * service pages that carry the detail, over the app logo marquee.
 *
 * The tiles pull into focus as they arrive (blur and scale, on the same scroll
 * timeline Reveal uses) and answer the pointer with a spotlight and a line
 * drawn around their border. Both of those need measurements only the browser
 * has, so a small script feeds the pointer position and the border length in as
 * custom properties — the motion itself is CSS.
 */
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);

const tiles: {
  icon: IconName;
  title: string;
  body: string;
  href: string;
  cta: string;
  featured?: boolean;
}[] = [
  {
    icon: 'smartphone',
    title: 'Mobile apps',
    body: `${apps.length || 'Ten'} Android apps — attendance, chat, POS, rentals and store checks — each one signed into your Odoo server.`,
    href: '/services/mobile-app-development#apps',
    cta: 'See the apps',
  },
  {
    icon: 'monitor',
    title: 'Desktop software',
    body: 'Offline-first Windows billing and back-office applications that keep working when the connection does not.',
    href: '/services/erp-solutions#desktop',
    cta: 'Desktop software',
    featured: true,
  },
];
const { locale, t } = Astro.locals;
/** Locale-prefixed: unprefixed 404s in dev and 301s to English live. */
const loc = (to: string) => {
  const [path, hash] = to.split('#');
  return localeHref(locale, path) + (hash ? `#${hash}` : '');
};
---

<section class="cc-surface border-brand-100 border-t py-18 lg:py-24">
  <div class="container-page">
    <SectionHeading
      eyebrow={t('softwareStrip.eyebrow')}
      title={t('softwareStrip.title')}
      marker="squiggle"
      color="yellow"
      lead={t('softwareStrip.lead')}
    />

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        tiles.map((t, i) => (
          <Reveal as="article" delay={i} class="h-full">
            <a
              href={loc(t.href)}
              class:list={['sw-card', t.featured && 'is-featured']}
              data-sw-card
            >
              <span class="sw-spot" aria-hidden="true" />
              <svg class="sw-trace" preserveAspectRatio="none" aria-hidden="true">
                <rect x="1" y="1" rx="8" />
              </svg>

              <span class="sw-tile">
                <Icon name={t.icon} class="size-6" />
              </span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
              <span class="sw-more">
                {t.cta}
                <Icon name="arrow-right" class="size-4" />
              </span>
            </a>
          </Reveal>
        ))
      }
    </div>
  </div>

  <AppMarquee />
</section>

<style>
  .sw-card {
    --sw-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.45s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  /* Spotlight under the pointer; --mx/--my come from the script. */
  .sw-spot {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      12.5rem circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--color-plum-600) 13%, transparent),
      transparent 70%
    );
    transition: opacity 0.35s ease;
  }

  /* Line drawn around the rim on hover; --len is the rect's own path length. */
  .sw-trace {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
  }
  .sw-trace rect {
    fill: none;
    stroke: var(--color-brand-500);
    stroke-width: 2;
    stroke-dasharray: var(--len, 1200);
    stroke-dashoffset: var(--len, 1200);
    transition: stroke-dashoffset 0.85s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .sw-tile {
    position: relative;
    display: grid;
    isolation: isolate;
    overflow: hidden;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-btn);
    background: var(--color-plum-50);
    color: var(--color-plum-600);
    transition:
      transform 0.5s var(--sw-spring),
      color 0.35s ease,
      box-shadow 0.4s ease;
  }
  .sw-tile::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--color-plum-600);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.22, 0.9, 0.32, 1.2);
  }
  .sw-tile :global(svg) {
    transition: transform 0.5s var(--sw-spring);
  }

  .sw-card h3 {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    transition: color 0.3s ease;
  }
  .sw-card p {
    flex: 1;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-muted);
  }
  .sw-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-700);
    transition: color 0.3s ease;
  }
  .sw-more :global(svg) {
    transition: transform 0.35s var(--sw-spring);
  }

  /* The middle tile reads as already-activated, so its flood turns blue. */
  .is-featured {
    border-color: var(--color-plum-300);
  }
  .is-featured .sw-tile {
    color: #fff;
  }
  .is-featured .sw-tile::before {
    transform: scale(1);
  }
  .is-featured:hover .sw-tile::before,
  .is-featured:focus-visible .sw-tile::before {
    background: var(--color-brand-500);
  }

  .sw-card:hover,
  .sw-card:focus-visible {
    transform: translateY(-5px);
    border-color: var(--color-plum-300);
    box-shadow: var(--shadow-lift);
  }
  .sw-card:hover .sw-spot {
    opacity: 1;
  }
  .sw-card:hover .sw-trace rect,
  .sw-card:focus-visible .sw-trace rect {
    stroke-dashoffset: 0;
  }
  .sw-card:hover .sw-tile,
  .sw-card:focus-visible .sw-tile {
    transform: translateY(-2px);
    color: #fff;
    box-shadow: 0 10px 20px color-mix(in srgb, var(--color-plum-600) 28%, transparent);
  }
  .sw-card:hover .sw-tile::before,
  .sw-card:focus-visible .sw-tile::before {
    transform: scale(1);
  }
  .sw-card:hover .sw-tile :global(svg),
  .sw-card:focus-visible .sw-tile :global(svg) {
    transform: scale(1.12);
  }
  .sw-card:hover h3,
  .sw-card:focus-visible h3 {
    color: var(--color-plum-600);
  }
  .sw-card:hover .sw-more :global(svg),
  .sw-card:focus-visible .sw-more :global(svg) {
    transform: translateX(5px);
  }

  /* Entrance: the card resolves out of a blur. `scale` and `filter` rather than
     `transform`, so the hover lift still applies once it has landed. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .sw-card {
        animation: sw-focus linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 24%;
      }
    }
  }

  /* `to` is omitted on purpose: it resolves to the static styles above. */
  @keyframes sw-focus {
    from {
      scale: 0.94;
      filter: blur(6px);
    }
  }
</style>

<script>
  function mountSoftwareCards() {
    document.querySelectorAll<HTMLElement>('[data-sw-card]').forEach((card) => {
      const svg = card.querySelector('svg.sw-trace');
      const rect = svg?.querySelector('rect');
      if (!svg || !rect) return;

      // The rim line is a real rect, so its dash length has to follow the card's
      // rendered size — which only the browser knows, and which reflows.
      const measure = () => {
        const box = card.getBoundingClientRect();
        if (!box.width) return;
        svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
        rect.setAttribute('width', String(box.width - 2));
        rect.setAttribute('height', String(box.height - 2));
        rect.style.setProperty('--len', String(rect.getTotalLength()));
      };
      measure();
      if ('ResizeObserver' in window) new ResizeObserver(measure).observe(card);
      else addEventListener('resize', measure);

      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${((event.clientX - box.left) / box.width) * 100}%`);
        card.style.setProperty('--my', `${((event.clientY - box.top) / box.height) * 100}%`);
      });
    });
  }

  document.addEventListener('astro:page-load', mountSoftwareCards);
</script>
