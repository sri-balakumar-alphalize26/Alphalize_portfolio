---
import { Heading } from '@alphalize/astro-marker';
import MarkedTitle from './MarkedTitle.astro';
import type { MarkerType } from './marks';
import Reveal from './Reveal.astro';

interface Props {
  eyebrow?: string;
  /** Phrases to wrap in a marker stroke are marked inline — see marks.ts. */
  title: string;
  marker?: MarkerType;
  color?: string;
  lead?: string;
  align?: 'left' | 'center';
  /** Use on dark backgrounds. */
  invert?: boolean;
  class?: string;
  /**
   * Opt into the sequenced entrance from <AboutAnim>, replacing the default
   * <Reveal>. The two cannot share an element: [data-reveal]'s
   * `animation-timeline: view()` animation would override the .ab-* transitions.
   *
   * This does NOT emit `data-ab` — the enclosing section owns that, and these
   * classes react to the `.in` it receives.
   */
  anim?: boolean;
}

const {
  eyebrow,
  title,
  marker,
  color,
  lead,
  align = 'center',
  invert = false,
  class: className,
  anim = false,
} = Astro.props;

const Wrapper = anim ? 'div' : Reveal;
---

<Wrapper class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class:list={['eyebrow', anim && 'ab-track']}>{eyebrow}</p>}
  {
    /* Under `anim` the wrapper is the clip box the heading rises out of. One
      mask for the whole heading, not one per line: `title` is a string that
      wraps wherever the viewport puts it, so there are no line boxes to split. */
  }
  <div class:list={['mt-2', anim && 'ab-ln']}>
    <Heading
      as="h2"
      size="lg"
      align={align}
      class:list={[invert && 'text-white', anim && 'ab-lni']}
    >
      <MarkedTitle title={title} marker={marker} color={color} delay={anim ? 1000 : 0} />
    </Heading>
  </div>
  {
    lead && (
      <p
        class:list={[
          'mt-4 text-base leading-relaxed',
          invert ? 'text-brand-200' : 'text-muted',
          anim && 'ab ab-fade',
        ]}
        style={anim ? '--d:1150ms' : undefined}
      >
        {lead}
      </p>
    )
  }
</Wrapper>
