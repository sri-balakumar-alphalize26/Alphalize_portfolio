---
import { getLocalized } from '@/i18n/collections';
import { localeHref } from '@/i18n/paths';
import { getCollection } from 'astro:content';
import ArrowButton from './ArrowButton.astro';
import Reveal from './Reveal.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';

/**
 * "Services we offer" — the homepage highlight grid.
 *
 * The cards carry their own entrance and hover treatment (see ServiceCard),
 * and the closing button is the shared ArrowButton, so all that lives here is
 * the section frame and which services go in the grid.
 */
const services = await getLocalized('services', Astro.locals.locale);
const featured = services.filter((s) => s.entry.data.featured);

const { locale, t } = Astro.locals;
/** Prefix an internal path with this page's locale. */
const loc = (to: string) => localeHref(locale, to);
---

<Section variant="white" space="lg">
  <SectionHeading
    eyebrow={t('servicesCards.eyebrow')}
    title={t('servicesCards.title')}
    lead={t('servicesCards.lead')}
  />

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {featured.map((service, i) => <ServiceCard service={service} delay={i} />)}
  </div>

  <Reveal class="mt-10 text-center">
    <ArrowButton href={loc('/services')}
      >{t('servicesCards.allServices', { count: services.length })}</ArrowButton
    >
  </Reveal>
</Section>
