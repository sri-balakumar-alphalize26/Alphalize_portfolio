---
import AboutAnim from '@/components/AboutAnim.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import TrustedPartners from '@/components/TrustedPartners.astro';
import WhyChooseUs from '@/components/WhyChooseUs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { offices } from '@/config/site';
---

<BaseLayout
  title="About Alphalize"
  description="Alphalize helps businesses turn manual processes into automated workflows — ERP implementation, business intelligence and custom software, from Kollam, Kerala."
>
  <AboutAnim />

  <PageHero
    anim
    eyebrow="About us"
    title="We help implement your ideas into automation"
    lead="We understand the power of automation in streamlining business processes and unlocking operational efficiency — and we are more interested in what it changes for you than in the technology itself."
  />

  {/*
    Narrative. Driven by <AboutAnim> rather than <Reveal>: the two cannot share
    an element, because [data-reveal]'s `animation-timeline: view()` animation
    would override the .ab transition on opacity/transform.
  */}
  <section class="container-page py-16 lg:py-20" data-ab data-hold="1000">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="prose-content">
          <p class="ab ab-left" style="--d:0ms">
            At Alphalize, we understand the power of automation in streamlining business processes
            and unlocking operational efficiency. We are passionate about helping our clients bring
            their ideas to life and transforming manual tasks into automated workflows. Whether you
            have a specific automation concept in mind or need guidance in identifying opportunities
            for automation, our team of experts is here to guide you through the implementation
            process.
          </p>
          <h2 class="ab ab-left" style="--d:170ms">
            <span class="ab-underline">It starts with your vision</span>
          </h2>
          <p class="ab ab-left" style="--d:300ms">
            We believe that successful automation begins with a clear understanding of your vision.
            Our team takes the time to listen and comprehend your ideas, goals and pain points. We
            collaborate closely with you to gain insight into your existing processes, identify
            areas that can benefit from automation, and tailor solutions that align with your
            vision.
          </p>
          <p class="ab ab-left" style="--d:420ms">
            We combine your expertise in your industry with our technical proficiency to create
            automation solutions that drive tangible results — because the person who knows where
            the time is being lost is usually already inside your business.
          </p>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div
          class="cc-surface rounded-card border-brand-100 ab ab-card border p-7"
          style="--d:230ms"
        >
          <h2 class="text-ink ab text-base font-semibold" style="--d:520ms">Where we work</h2>
          <ul class="mt-4 space-y-5">
            {
              offices.map((o, i) => (
                <li class="flex gap-3">
                  <span
                    class="rounded-btn text-plum-600 ab-pin mt-0.5 flex size-9 shrink-0 items-center justify-center bg-white"
                    style={`--d:${680 + i * 190}ms`}
                  >
                    <Icon name="pin" class="size-4" />
                  </span>
                  <span class="text-muted ab text-sm leading-relaxed" style={`--d:${740 + i * 190}ms`}>
                    <span class="text-ink block font-semibold">{o.label}</span>
                    {o.street}
                    <br />
                    {o.locality}, {o.region} {o.postalCode}
                  </span>
                </li>
              ))
            }
          </ul>
          <span class="ab-line bg-brand-200/60 mt-6 block h-px" style="--d:1080ms"></span>
          <p class="text-muted ab mt-5 text-sm leading-relaxed" style="--d:1220ms">
            Support runs around the clock from Kollam, so implementation cover overlaps with Indian,
            Gulf and US business hours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <WhyChooseUs />

  <TrustedPartners />

  <CtaBand />
</BaseLayout>
