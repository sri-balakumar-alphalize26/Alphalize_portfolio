---
import { Heading } from '@alphalize/astro-marker';
import Icon from './Icon.astro';
import MarkedTitle from './MarkedTitle.astro';
import { stripMarks } from './marks';
import { localeHref } from '@/i18n/paths';
import { site } from '@/config/site';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Breadcrumb trail, excluding Home and the current page. */
  crumbs?: { label: string; href: string }[];
  /**
   * Opt into the sequenced entrance from <AboutAnim>. Off everywhere else, so
   * the other interior heroes keep rendering exactly as they do today.
   */
  anim?: boolean;
}

const { eyebrow, title, lead, crumbs = [], anim = false } = Astro.props;

/**
 * The Home crumb was `href="/"` with the literal word "Home", on every interior
 * page in all nine locales.
 *
 * Both halves were wrong. `/` is not locale-negotiating — src/pages/index.astro
 * 302s to /en unconditionally — so an Arabic reader clicking Home landed on the
 * English homepage with the locale silently gone, which is the same failure
 * b3c5b43 set out to eliminate. check-links.mjs misses it because it whitelists
 * `/` on the assumption that the negotiation described in that file's own
 * comment already exists; it is still an intention, not behaviour.
 */
const { locale, t } = Astro.locals;
const homeHref = localeHref(locale, '/');

/**
 * The breadcrumb repeats the title as plain text, so it needs the words without
 * the strokes.
 *
 * This used to underline the last space-delimited word automatically, which is
 * where the Odoo signature came from. That was replaced by an explicit [[mark]]
 * in the title (see marks.ts) because the split had no answer for a language
 * without spaces: in Chinese the whole heading is one "word", the
 * `words.length > 1` test fails, and every interior hero silently loses its
 * underline.
 */
const plainTitle = stripMarks(title);

/**
 * The same trail again, for search engines.
 *
 * Emitted here rather than passed up to BaseLayout because this component is
 * the only thing that knows the crumbs — a page would otherwise have to declare
 * them twice and the two copies would drift.
 *
 * The current page carries no `item`: it is where the reader already is, and
 * Google's guidance is to leave the last entry unlinked. `<` is escaped for the
 * reason Seo.astro escapes it — these labels are translated strings.
 */
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: t('nav.home'), href: homeHref },
    ...crumbs.map((c) => ({ name: c.label, href: c.href })),
    { name: plainTitle, href: undefined },
  ].map((entry, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: entry.name,
    ...(entry.href ? { item: new URL(entry.href, site.url).href } : {}),
  })),
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')}
/>

<section
  class="cc-white border-brand-100 relative isolate overflow-hidden border-b"
  data-ab={anim ? '' : undefined}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_55%_70%_at_12%_0%,var(--color-brand-50),transparent_60%),radial-gradient(ellipse_45%_60%_at_92%_10%,var(--color-plum-50),transparent_55%)]"
  >
  </div>

  <div class="container-page py-12 lg:py-16">
    <nav
      aria-label="Breadcrumb"
      class:list={[anim && 'ab ab-fade']}
      style={anim ? '--d:0ms' : undefined}
    >
      <ol class="text-muted flex flex-wrap items-center gap-1.5 text-xs">
        <li><a href={homeHref} class="hover:text-plum-600">{t('nav.home')}</a></li>
        {
          crumbs.map((c) => (
            <>
              <li aria-hidden="true">
                <Icon name="chevron-right" class="size-3" />
              </li>
              <li>
                <a href={c.href} class="hover:text-plum-600">
                  {c.label}
                </a>
              </li>
            </>
          ))
        }
        <li aria-hidden="true"><Icon name="chevron-right" class="size-3" /></li>
        <li aria-current="page" class="text-heading">{plainTitle}</li>
      </ol>
    </nav>

    {eyebrow && <p class:list={['eyebrow mt-7', anim && 'ab-track']}>{eyebrow}</p>}

    {
      /* Under `anim` the wrapper is the clip box the heading rises out of. One
        mask for the whole heading, not one per line: the title is a string that
        wraps wherever the viewport puts it, so there are no line boxes to split
        on. The extra bottom padding keeps the mask clear of the <Marker> stroke,
        which is drawn below the text box. */
    }
    <div class:list={['mt-2 max-w-3xl', anim && 'ab-ln']}>
      <Heading as="h1" size="lg" class:list={[anim && 'ab-lni']}>
        <MarkedTitle title={title} marker="underline" color="blue" delay={anim ? 950 : 0} />
      </Heading>
    </div>

    {
      lead && (
        <p
          class:list={['lead text-muted mt-5 max-w-2xl', anim && 'ab-words']}
          data-base={anim ? '820' : undefined}
          data-step={anim ? '34' : undefined}
        >
          {lead}
        </p>
      )
    }
  </div>
</section>
