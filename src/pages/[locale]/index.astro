---
import CtaBand from '@/components/CtaBand.astro';
import Hero from '@/components/Hero.astro';
import ModulesIntro from '@/components/ModulesIntro.astro';
import PartnerMosaic from '@/components/PartnerMosaic.astro';
import ServicesCards from '@/components/ServicesCards.astro';
import SoftwareStrip from '@/components/SoftwareStrip.astro';
import StatBand from '@/components/StatBand.astro';
import Testimonials from '@/components/Testimonials.astro';
import WelcomeIntro from '@/components/WelcomeIntro.astro';
import WhatWeDo from '@/components/WhatWeDo.astro';
import WhyCards from '@/components/WhyCards.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';

/**
 * Metadata from the catalogue, not from src/config/site.ts.
 *
 * The title was a template literal and the description was the `site.description`
 * CONSTANT, so all nine home pages carried identical English metadata — nine
 * hreflang alternates that read as one page rather than as translations of each
 * other. Both strings exist translated in all nine catalogues; they simply were
 * not being read.
 */
const { t } = Astro.locals;
---

<BaseLayout title={t('site.metaTitle')} description={t('site.description')}>
  <Hero />

  <WhatWeDo />

  <!-- Value blocks -->
  <WhyCards />

  <!-- Services -->
  <ServicesCards />

  <SoftwareStrip />

  <!-- ERP modules, introduced by the wordmark -->
  <ModulesIntro />

  <!-- Stats band -->
  <StatBand />

  <!-- About -->
  <WelcomeIntro />

  <!-- Who we build with -->
  <PartnerMosaic />

  <!-- Client reviews -->
  <Testimonials />

  <CtaBand />
</BaseLayout>
