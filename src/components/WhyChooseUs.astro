---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

/**
 * "Why choose us" — the three About-page value cards.
 *
 * Distinct from WhyCards on the homepage, deliberately: these are driven by
 * the sequenced <AboutAnim> engine rather than <Reveal>, so they land on the
 * same clock as the rest of /about, and they carry their own hover language
 * (a bar across the top edge, the icon tile morphing square → circle) rather
 * than the rail-and-shine treatment WhyCards uses.
 *
 * The card entrance unfolds sideways from a hairline at its centre. That is a
 * clip-path, so it has to be released once the entrance finishes — see the
 * `.done` rules below.
 */
const reasons = [
  {
    icon: 'award' as const,
    title: 'Proven expertise and track record',
    body: 'When it comes to ERP software, choosing a trusted and experienced partner is crucial. Our team has delivered numerous ERP implementations for clients across a range of industries.',
  },
  {
    icon: 'layers' as const,
    title: 'Tailored to your requirements',
    body: 'Every business is unique, with its own requirements and goals. We take a consultative approach — understanding your processes, challenges and objectives before proposing a solution.',
  },
  {
    icon: 'users' as const,
    title: 'Service and support that continues',
    body: 'From the initial consultation through implementation and beyond, our team stays available. Go-live is the start of the relationship, not the end of the engagement.',
  },
];
const { t } = Astro.locals;
---

<section class="wcu cc-surface border-brand-100 border-t py-18 lg:py-24" data-ab>
  <div class="container-page">
    <SectionHeading
      anim
      eyebrow={t('whyChooseUs.eyebrow')}
      title={t('whyChooseUs.title')}
      marker="circle"
      color="blue"
    />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        reasons.map((r, i) => (
          <article class="wcu-card" style={`--d:${420 + i * 170}ms`}>
            <span class="wcu-edge" aria-hidden="true" />
            <div class="wcu-inner">
              <span class="wcu-tile" style={`--d:${700 + i * 170}ms`}>
                <Icon name={r.icon} class="size-6" />
              </span>
              <h3 style={`--d:${790 + i * 170}ms`}>{r.title}</h3>
              <p style={`--d:${870 + i * 170}ms`}>{r.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wcu-card {
    /* Kept local rather than leaning on about-anim.css, so the component still
       renders correctly if it is ever used on a page without <AboutAnim>. */
    --wcu-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --wcu-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    position: relative;
    overflow: hidden;
    height: 100%;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    background: #fff;
    transition:
      transform 0.4s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.35s ease,
      box-shadow 0.4s ease;
  }
  .wcu-inner {
    padding: 1.75rem;
  }

  /* Parked at zero width in the centre; runs out to both edges on hover. */
  .wcu-edge {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    pointer-events: none;
    background: linear-gradient(90deg, var(--color-plum-600), var(--color-brand-500));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.55s var(--wcu-ease);
  }

  .wcu-tile {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-btn);
    background: var(--color-plum-50);
    color: var(--color-plum-600);
    transition:
      border-radius 0.45s var(--wcu-spring),
      background 0.35s ease,
      color 0.35s ease,
      transform 0.45s var(--wcu-spring);
  }
  .wcu-tile :global(svg) {
    transition: transform 0.45s var(--wcu-spring);
  }

  .wcu-card h3 {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    transition: color 0.3s ease;
  }
  .wcu-card p {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-muted);
  }

  /* --- hover: no big lift; the tile morphs and the top edge runs across --- */
  .wcu-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-200);
    box-shadow: var(--shadow-lift);
  }
  .wcu-card:hover .wcu-edge {
    transform: scaleX(1);
  }
  .wcu-card:hover .wcu-tile {
    border-radius: 50%;
    background: var(--color-plum-600);
    color: #fff;
    transform: rotate(6deg);
  }
  .wcu-card:hover .wcu-tile :global(svg) {
    transform: rotate(-6deg) scale(1.1);
  }
  .wcu-card:hover h3 {
    color: var(--color-plum-600);
  }

  /* --- entrance: the card unfolds from a hairline at its centre --- */
  :global(html.ab-js) .wcu-card {
    clip-path: inset(46% 50% 46% 50% round var(--radius-card));
    transition:
      clip-path 0.75s cubic-bezier(0.62, 0.03, 0.21, 1),
      transform 0.4s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.35s ease,
      box-shadow 0.4s ease;
    transition-delay: calc(var(--b, 0ms) + var(--d, 0ms));
  }
  :global(html.ab-js) .wcu.in .wcu-card {
    clip-path: inset(0 0 0 0 round var(--radius-card));
  }

  /* Contents follow once the panel is open. */
  :global(html.ab-js) .wcu-tile,
  :global(html.ab-js) .wcu-card h3,
  :global(html.ab-js) .wcu-card p {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s var(--wcu-ease),
      transform 0.55s var(--wcu-ease);
    transition-delay: calc(var(--b, 0ms) + var(--d, 0ms));
  }
  :global(html.ab-js) .wcu-tile {
    transform: translateY(14px) scale(0.7);
  }
  :global(html.ab-js) .wcu.in .wcu-tile,
  :global(html.ab-js) .wcu.in .wcu-card h3,
  :global(html.ab-js) .wcu.in .wcu-card p {
    opacity: 1;
    transform: none;
  }

  /* Hand both back to their hover transitions once the entrance is over.
     `.done` lands 2600ms after `.in`, well past the last card at ~1760ms.

     Releasing the clip-path matters: `inset(0)` still clips at the border box,
     so the hover box-shadow — drawn outside it — would never be visible. The
     jump to `none` is not animatable but is visually identical, so it does not
     flash. Clearing transition-delay matters too, or hover would sit behind the
     entrance stagger by up to 760ms. */
  :global(html.ab-js) .wcu.in.done .wcu-card {
    clip-path: none;
    transition:
      transform 0.4s cubic-bezier(0.22, 0.9, 0.32, 1.2),
      border-color 0.35s ease,
      box-shadow 0.4s ease;
    transition-delay: 0s;
  }
  :global(html.ab-js) .wcu.in.done .wcu-tile {
    transition:
      border-radius 0.45s var(--wcu-spring),
      background 0.35s ease,
      color 0.35s ease,
      transform 0.45s var(--wcu-spring);
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.ab-js) .wcu-card {
      clip-path: none !important;
    }
    :global(html.ab-js) .wcu-tile,
    :global(html.ab-js) .wcu-card h3,
    :global(html.ab-js) .wcu-card p {
      opacity: 1 !important;
      transform: none !important;
    }
    .wcu-card,
    .wcu-edge,
    .wcu-tile,
    .wcu-tile :global(svg) {
      transition: none;
    }
  }
</style>
