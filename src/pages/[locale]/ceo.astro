---
import AboutAnim from '@/components/AboutAnim.astro';
import CtaBand from '@/components/CtaBand.astro';
import LeaderCard from '@/components/LeaderCard.astro';
import AwardBlock from '@/components/AwardBlock.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import YouTubeRail from '@/components/YouTubeRail.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ceo, talks } from '@/config/ceo';

/**
 * The Managing Director's page, from the 369 /ceo.
 *
 * Four bands: <LeaderCard> for the portrait and bio, then the BizConnect
 * award, his talks, and the CTA. The copy is rewritten — see the note in
 * src/config/ceo.ts on what changed and why.
 *
 * MOTION. Each band owns its own entrance and its own [data-ab] unit, so they
 * reveal as they are scrolled to rather than all at once. The engine is
 * about-anim.ts: html.ab-js arms the hidden states, .in releases them.
 */
export { localeStaticPaths as getStaticPaths } from '@/i18n/paths';
---

<BaseLayout title={`${ceo.name} — ${ceo.role}`} description={ceo.intro[0].slice(0, 155)}>
  <AboutAnim />

  {/* Portrait, name, role and bio, with its own entrance — see LeaderCard. */}
  <LeaderCard />

  {/* Kicker, heading, the two dealt photos and the presentation clip. */}
  <AwardBlock />

  <Section variant="white" space="lg">
    <div data-ab>
      <SectionHeading anim title={ceo.talks.title} lead={ceo.talks.body} />
      <div class="mt-12">
        <YouTubeRail talks={talks} channel={ceo.talks.channel} />
      </div>
    </div>
  </Section>

  <CtaBand title={ceo.cta.title} body={ceo.cta.body} />
</BaseLayout>
