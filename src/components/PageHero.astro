---
import { Heading, Marker } from '@alphalize/astro-marker';
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Breadcrumb trail, excluding Home and the current page. */
  crumbs?: { label: string; href: string }[];
  /**
   * Opt into the sequenced entrance from <AboutAnim>. Off everywhere else, so
   * the other interior heroes keep rendering exactly as they do today.
   */
  anim?: boolean;
}

const { eyebrow, title, lead, crumbs = [], anim = false } = Astro.props;

// Odoo underlines the last word of a heading; do the same when the title has
// more than one word, so interior pages carry the same signature as the home hero.
const words = title.trim().split(/\s+/);
const head = words.length > 1 ? words.slice(0, -1).join(' ') : title;
const tail = words.length > 1 ? words[words.length - 1] : '';
---

<section
  class="cc-white border-brand-100 relative isolate overflow-hidden border-b"
  data-ab={anim ? '' : undefined}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_55%_70%_at_12%_0%,var(--color-brand-50),transparent_60%),radial-gradient(ellipse_45%_60%_at_92%_10%,var(--color-plum-50),transparent_55%)]"
  >
  </div>

  <div class="container-page py-12 lg:py-16">
    <nav aria-label="Breadcrumb" class:list={[anim && 'ab ab-fade']} style={anim ? '--d:0ms' : undefined}>
      <ol class="text-muted flex flex-wrap items-center gap-1.5 text-xs">
        <li><a href="/" class="hover:text-plum-600">Home</a></li>
        {
          crumbs.map((c) => (
            <>
              <li aria-hidden="true"><Icon name="chevron-right" class="size-3" /></li>
              <li>
                <a href={c.href} class="hover:text-plum-600">
                  {c.label}
                </a>
              </li>
            </>
          ))
        }
        <li aria-hidden="true"><Icon name="chevron-right" class="size-3" /></li>
        <li aria-current="page" class="text-heading">{title}</li>
      </ol>
    </nav>

    {eyebrow && <p class:list={['eyebrow mt-7', anim && 'ab-track']}>{eyebrow}</p>}

    {/* Under `anim` the wrapper is the clip box the heading rises out of. One
        mask for the whole heading, not one per line: the title is a string that
        wraps wherever the viewport puts it, so there are no line boxes to split
        on. The extra bottom padding keeps the mask clear of the <Marker> stroke,
        which is drawn below the text box. */}
    <div class:list={['mt-2 max-w-3xl', anim && 'ab-ln']}>
      <Heading as="h1" size="lg" class:list={[anim && 'ab-lni']}>
        {
          tail ? (
            <>
              {head}{' '}
              <Marker type="underline" color="blue" delay={anim ? 950 : 0}>
                {tail}
              </Marker>
            </>
          ) : (
            title
          )
        }
      </Heading>
    </div>

    {
      lead && (
        <p
          class:list={['lead text-muted mt-5 max-w-2xl', anim && 'ab-words']}
          data-base={anim ? '820' : undefined}
          data-step={anim ? '34' : undefined}
        >
          {lead}
        </p>
      )
    }
  </div>
</section>
