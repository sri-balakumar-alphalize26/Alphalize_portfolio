---
/**
 * <Fonts> — optional Google Fonts loader for the default faces (Caveat + Inter).
 * Put it in <head>. Delete it once you self-host your own handwriting font and set --mk-font-hand.
 */
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;600;700&display=swap" />
