---
/**
 * <Heading> — handwriting-font heading.
 *   <Heading as="h1" size="xl" align="center">All your business on <Marker type="highlight">one platform</Marker>.</Heading>
 * as     h1 | h2 | h3 | p | span   (default h2)
 * size   xl | lg | md | sm         (default lg)
 * align  left | center
 */
export interface Props { as?: 'h1' | 'h2' | 'h3' | 'h4' | 'p' | 'span' | 'div'; size?: 'xl' | 'lg' | 'md' | 'sm'; align?: 'left' | 'center'; class?: string }
const { as: Tag = 'h2', size = 'lg', align = 'left', class: className = '' } = Astro.props;
---
<Tag class:list={['mk-hand', `mk-hand--${size}`, { 'mk-hand--center': align === 'center' }, className]}><slot /></Tag>