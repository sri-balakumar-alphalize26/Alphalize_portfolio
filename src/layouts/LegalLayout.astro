---
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from './BaseLayout.astro';
import { legalNav, site } from '@/config/site';
import { stripMarks } from '@/components/marks';
import { localeHref, splitLocale } from '@/i18n/paths';
import { localeLabels } from '@/i18n/locales';

interface Props {
  /** Phrases to wrap in a marker stroke are marked inline — see marks.ts. */
  title: string;
  description: string;
  /** The date the page last changed. Formatted here, per locale. */
  updated: Date;
  /** 'en' when this locale has no translation — marks the prose, not the page. */
  lang?: string;
  /** Site-root-absolute path to a 1200x630 share image. Omit for the default. */
  ogImagePath?: string;
}

const { title, description, updated, lang, ogImagePath } = Astro.props;
// The hero draws the strokes; <title> and og:title want the words only.
const plainTitle = stripMarks(title);
// Locale-free and extension-free, so it can be compared against the plain
// hrefs in legalNav. Without either step no sidebar link is ever marked
// current: the pathname here is "/en/legal/privacy-policy.html".
const { path } = splitLocale(Astro.url.pathname);

/** Prefix an internal path with this page's locale. */
const { locale, t } = Astro.locals;
const loc = (to: string) => localeHref(locale, to);

/**
 * Two overrides on the locale's own BCP-47 tag:
 *   en → en-GB, or the date reads "September 8, 2026" in a British-spelled site
 *   ar → Western digits, rather than the Arabic-Indic set Intl defaults to
 * timeZone pins the day — a server west of UTC would otherwise render the 7th.
 */
const DATE_TAG: Partial<Record<typeof locale, string>> = {
  en: 'en-GB',
  ar: 'ar-u-nu-latn',
};
const updatedText = new Intl.DateTimeFormat(DATE_TAG[locale] ?? localeLabels[locale].hreflang, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(updated);
/** Machine-readable, and locale-independent. */
const updatedIso = updated.toISOString().slice(0, 10);

/**
 * The three legal documents carried no structured data at all, because this
 * layout never accepted a `jsonLd` prop to forward.
 *
 * `dateModified` is the date the pill already shows the reader — the one field
 * here that genuinely helps, since a policy is judged on how current it is.
 */
const legalPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: new URL(Astro.url.pathname, site.url).href,
  name: plainTitle,
  description,
  dateModified: updatedIso,
  inLanguage: localeLabels[locale].hreflang,
  isPartOf: { '@id': `${site.url}/#website` },
  publisher: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout
  title={plainTitle}
  description={description}
  jsonLd={[legalPage]}
  ogImagePath={ogImagePath}
>
  <PageHero title={title} eyebrow={t('common.legal')} />

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <article class="lg:col-span-8">
      {
        /*
          Two-tone pill: label panel, then the date, with the brand blue down
          the leading edge. `border-s` rather than border-left, so the bar moves
          to the right in Arabic. It wraps rather than holding one line —
          "Last updated" is long in Tamil and German, and the two halves
          together overrun a 390px phone; wrapping stacks them instead of
          pushing the pill off the page.
        */
      }
      <span
        class="border-brand-100 border-s-brand-500 inline-flex max-w-full flex-wrap items-stretch overflow-hidden rounded-[10px] border border-s-[3px] bg-white align-middle"
      >
        <span
          class="bg-brand-50 text-ink inline-flex items-center gap-[7px] px-3.5 py-2.5 text-[13px] font-bold whitespace-nowrap"
        >
          <Icon name="clock" class="text-brand-600 size-[15px] shrink-0" />
          {t('legal.updatedLabel')}
        </span>
        <span class="text-muted inline-flex items-center px-4 py-2.5 text-[13.5px] tabular-nums">
          <time datetime={updatedIso}>{updatedText}</time>
        </span>
      </span>
      <div class="prose-content mt-10" lang={lang} dir={lang ? 'ltr' : undefined}>
        <slot />
      </div>
    </article>

    <aside class="lg:col-span-4">
      <nav class="lg:sticky lg:top-28" aria-label="Legal pages">
        <h2 class="text-ink text-sm font-semibold tracking-wider uppercase">{t('common.legal')}</h2>
        <ul class="divide-brand-100 mt-3 divide-y">
          {
            legalNav.map((l) => (
              <li>
                <a
                  href={loc(l.href)}
                  aria-current={path === l.href ? 'page' : undefined}
                  class:list={[
                    'block py-2.5 text-sm transition-colors',
                    path === l.href
                      ? 'text-brand-700 font-semibold'
                      : 'text-muted hover:text-brand-700',
                  ]}
                >
                  {t(l.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>
