---
import { getCollection, render } from 'astro:content';
import CareersForm from '@/components/CareersForm.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import Reveal from '@/components/Reveal.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { offices, site } from '@/config/site';

const jobs = (await getCollection('jobs', ({ data }) => data.open)).sort(
  (a, b) => b.data.postedAt.getTime() - a.data.postedAt.getTime()
);

const rendered = await Promise.all(
  jobs.map(async (job) => ({ job, Content: (await render(job)).Content }))
);

const positions = [...jobs.map((j) => j.data.title), 'Training / Internship Program', 'Other'];

const india = offices.find((o) => o.id === 'kollam')!;

// JobPosting markup makes these roles eligible for the Google Jobs experience.
const jsonLd = jobs.map((job) => ({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.data.title,
  description: job.data.summary,
  datePosted: job.data.postedAt.toISOString().slice(0, 10),
  employmentType: job.data.employmentType,
  hiringOrganization: { '@id': `${site.url}/#organization` },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: india.street,
      addressLocality: india.locality,
      addressRegion: india.region,
      postalCode: india.postalCode,
      addressCountry: india.countryCode,
    },
  },
  directApply: true,
  url: `${site.url}/careers#apply`,
}));
---

<BaseLayout
  title="Careers"
  description="Open roles at Alphalize — Angular Developer, Node.js Developer and System Administrator in Kollam, Kerala. Apply with your CV."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Careers"
    title="Job opportunities"
    lead="We are a small team delivering ERP and business intelligence work for clients in two countries. That means real ownership early — and code that goes in front of people who depend on it."
  />

  <!-- Openings -->
  <section class="container-page py-16 lg:py-20">
    <SectionHeading
      align="left"
      eyebrow={`${jobs.length} open ${jobs.length === 1 ? 'role' : 'roles'}`}
      title="Current openings"
      lead="All roles are based in our Kollam, Kerala office."
    />

    <div class="mt-10 space-y-4">
      {
        rendered.map(({ job, Content }, i) => (
          <Reveal as="article" delay={i}>
            <details
              class="group rounded-card border border-brand-100 bg-white transition-colors open:border-plum-300"
            >
              <summary
                class="flex cursor-pointer list-none items-start gap-4 p-6 [&::-webkit-details-marker]:hidden"
              >
                <span
                  class="flex size-11 shrink-0 items-center justify-center rounded-btn bg-plum-50 text-plum-600"
                >
                  <Icon name="briefcase" class="size-5" />
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block text-lg font-semibold text-ink">{job.data.title}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted">
                    {job.data.summary}
                  </span>
                  <span class="mt-3 flex flex-wrap gap-2 text-xs">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 font-medium text-brand-700">
                      <Icon name="pin" class="size-3" />
                      {job.data.location}
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 font-medium text-brand-700">
                      <Icon name="clock" class="size-3" />
                      {job.data.experience}
                    </span>
                  </span>
                </span>

                <span
                  class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full border border-brand-200 text-brand-700 transition-transform duration-300 group-open:rotate-180"
                >
                  <Icon name="chevron-down" class="size-4" />
                </span>
              </summary>

              <div class="border-t border-brand-100 px-6 py-6">
                <div class="prose-content">
                  <Content />
                </div>

                <div class="mt-6 grid gap-6 sm:grid-cols-2">
                  {job.data.responsibilities.length > 0 && (
                    <div>
                      <h3 class="text-sm font-semibold text-ink">What you will do</h3>
                      <ul class="mt-2.5 space-y-2">
                        {job.data.responsibilities.map((r) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-plum-600" />
                            <span>{r}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {job.data.requirements.length > 0 && (
                    <div>
                      <h3 class="text-sm font-semibold text-ink">What we are looking for</h3>
                      <ul class="mt-2.5 space-y-2">
                        {job.data.requirements.map((r) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-plum-600" />
                            <span>{r}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                <a
                  href="#apply"
                  class="btn btn-primary mt-7"
                >
                  Apply for this role
                  <Icon name="arrow-right" class="size-4" />
                </a>
              </div>
            </details>
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- Application form -->
  <section class="cc-surface border-t border-brand-100 py-16 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <Reveal>
          <CareersForm positions={positions} />
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>
