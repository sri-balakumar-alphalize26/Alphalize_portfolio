---
import Icon from './Icon.astro';

/**
 * A video that behaves like a GIF: a muted loop that plays only while it is on
 * screen, with no native chrome — so no download or picture-in-picture menu,
 * and right-click save is blocked. Hovering reveals a centre play button (the
 * first press restarts the film WITH sound; after that it toggles pause) and a
 * corner speaker that toggles sound without restarting.
 *
 * Ported from the 369 AmbientVideo. Two things there are worth keeping
 * verbatim, because both are easy to get wrong:
 *
 *   - `muted` must be on the element from the very first frame or the browser
 *     refuses to autoplay at all. It is set in the markup AND imperatively.
 *   - The icons follow the element's own play/pause/volumechange events rather
 *     than what the script thinks it just did — the browser can refuse or
 *     interrupt playback on its own, and the button must not lie about it.
 *
 * Under prefers-reduced-motion nothing autoplays: preload drops to metadata and
 * the first frame sits still until the visitor presses play. With JS off the
 * markup carries `controls`, so the clip is still playable with native chrome;
 * the script removes them and takes over.
 */
interface Props {
  src: string;
  poster?: string;
  class?: string;
}

const { src, poster, class: className } = Astro.props;
---

<div class:list={['av', className]} data-av>
  <video
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    controls
    preload="none"
    disablepictureinpicture
    controlslist="nodownload noremoteplayback noplaybackrate"></video>

  {
    /* Centre play/pause — appears on hover or keyboard focus. Hidden until the
      script runs, since without it the native controls are doing this job. */
  }
  <button type="button" class="av-toggle" data-av-toggle hidden aria-label="Play video">
    <span class="av-toggle-dot">
      <Icon name="play" class="av-i av-i-play" />
      <Icon name="pause" class="av-i av-i-pause" />
    </span>
  </button>

  {/* Corner speaker — sound on/off without restarting. */}
  <button
    type="button"
    class="av-sound"
    data-av-sound
    hidden
    aria-label="Unmute"
    aria-pressed="false"
  >
    <Icon name="volume-off" class="av-i av-i-muted" />
    <Icon name="volume-on" class="av-i av-i-loud" />
  </button>
</div>

<script>
  function initAmbientVideo() {
    document.querySelectorAll<HTMLElement>('[data-av]').forEach((root) => {
      if (root.dataset.avWired) return;
      root.dataset.avWired = '1';

      const video = root.querySelector('video');
      const toggle = root.querySelector<HTMLButtonElement>('[data-av-toggle]');
      const sound = root.querySelector<HTMLButtonElement>('[data-av-sound]');
      if (!video || !toggle || !sound) return;

      // The script is running, so take the native chrome away and show ours.
      video.controls = false;
      video.muted = true;
      toggle.hidden = false;
      sound.hidden = false;
      root.classList.add('is-js');

      // First deliberate press means "watch it properly", so it restarts with
      // sound; every press after that is an ordinary pause/resume.
      let started = false;

      const sync = () => {
        const showPlay = video.paused || !started;
        root.classList.toggle('is-playing', !showPlay);
        toggle.setAttribute('aria-label', showPlay ? 'Play video' : 'Pause video');
        root.classList.toggle('is-muted', video.muted);
        sound.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
        sound.setAttribute('aria-pressed', String(!video.muted));
      };

      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);
      video.addEventListener('volumechange', sync);
      video.addEventListener('contextmenu', (e) => e.preventDefault());

      toggle.addEventListener('click', () => {
        if (!started) {
          started = true;
          video.muted = false;
          video.currentTime = 0;
          void video.play().catch(() => undefined);
          return;
        }
        if (video.paused) void video.play().catch(() => undefined);
        else video.pause();
      });

      sound.addEventListener('click', () => {
        video.muted = !video.muted;
        if (video.paused) void video.play().catch(() => undefined);
      });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.preload = 'metadata';
        sync();
        return;
      }

      // Ambient loop only while on screen: the file is neither fetched nor
      // decoded until the visitor has scrolled to it.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              video.preload = 'auto';
              void video.play().catch(() => undefined);
            } else if (!video.paused) {
              video.pause();
            }
          },
          { threshold: 0.35 }
        ).observe(video);
      }

      sync();
    });
  }

  document.addEventListener('astro:page-load', initAmbientVideo);
  if (document.readyState !== 'loading') initAmbientVideo();
  else document.addEventListener('DOMContentLoaded', initAmbientVideo, { once: true });
</script>

<style>
  .av {
    position: relative;
    height: 100%;
  }
  .av video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* display:flex/grid below would beat the UA [hidden] rule, so both our
     controls and the native ones would show before the script runs. */
  .av-toggle[hidden],
  .av-sound[hidden] {
    display: none;
  }

  /* --- centre play/pause --- */
  .av-toggle {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(4 30 57 / 0);
    opacity: 0;
    cursor: pointer;
    transition:
      opacity 0.3s ease,
      background-color 0.3s ease;
  }
  .av:hover .av-toggle,
  .av-toggle:focus-visible {
    opacity: 1;
    background: rgb(4 30 57 / 0.25);
  }
  .av-toggle-dot {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.95);
    color: var(--color-brand-700);
    box-shadow: 0 10px 24px rgb(4 30 57 / 0.3);
    transition: transform 0.25s var(--ease-out-soft);
  }
  .av:hover .av-toggle-dot {
    transform: scale(1.05);
  }
  .av-toggle :global(.av-i) {
    grid-area: 1 / 1;
    width: 1.5rem;
    height: 1.5rem;
  }
  /* The play triangle is optically left-heavy; nudge it into the circle. */
  .av-toggle :global(.av-i-play) {
    margin-inline-start: 0.125rem;
  }
  .av :global(.av-i-pause),
  .av.is-playing :global(.av-i-play) {
    display: none;
  }
  .av.is-playing :global(.av-i-pause) {
    display: block;
  }

  /* --- corner speaker --- */
  .av-sound {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(4 30 57 / 0.6);
    backdrop-filter: blur(4px);
    color: #fff;
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }
  .av:hover .av-sound,
  .av-sound:hover,
  .av-sound:focus-visible {
    opacity: 1;
  }
  .av-sound :global(.av-i) {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
  }
  .av :global(.av-i-loud) {
    display: none;
  }
  .av:not(.is-muted) :global(.av-i-loud) {
    display: block;
  }
  .av:not(.is-muted) :global(.av-i-muted) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .av-toggle,
    .av-toggle-dot,
    .av-sound {
      transition: none;
    }
    .av:hover .av-toggle-dot {
      transform: none;
    }
    /* No hover to discover it with on a touch device that also asks for less
       motion — leave the control visible. */
    .av.is-js .av-toggle {
      opacity: 1;
    }
  }
</style>
