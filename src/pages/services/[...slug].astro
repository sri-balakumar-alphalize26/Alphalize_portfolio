---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import AppShowcase from '@/components/AppShowcase.astro';
import CtaBand from '@/components/CtaBand.astro';
import DesktopSoftware from '@/components/DesktopSoftware.astro';
import Icon from '@/components/Icon.astro';
import ModulesGrid from '@/components/ModulesGrid.astro';
import PageHero from '@/components/PageHero.astro';
import Reveal from '@/components/Reveal.astro';
import SolutionCards from '@/components/SolutionCards.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const { title, summary, seoDescription, icon, highlights, showcase, solutions } = service.data;
const { Content } = await render(service);

// The mobile page lists the apps as SoftwareApplication entries for search engines.
const apps =
  showcase === 'apps'
    ? (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order)
    : [];

// Sibling services for the "explore more" rail.
const others = (await getCollection('services'))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: title,
    description: seoDescription ?? summary,
    url: `${site.url}/services/${service.id}`,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: ['US', 'IN'],
  },
];

if (apps.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Alphalize mobile apps',
    itemListElement: apps.map((app, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: app.data.title,
        description: app.data.tagline,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Android',
        author: { '@id': `${site.url}/#organization` },
      },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={seoDescription ?? summary}
  ogType="article"
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Service"
    title={title}
    lead={summary}
    crumbs={[{ label: 'Services', href: '/services' }]}
  />

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-20">
    <!-- Body -->
    <article class="prose-content lg:col-span-8">
      <Content />
    </article>

    <!-- Sidebar -->
    <aside class="lg:col-span-4">
      <div class="lg:sticky lg:top-28 lg:space-y-6">
        {
          highlights.length > 0 && (
            <Reveal
              class="cc-surface rounded-card border border-brand-100 p-6"
            >
              <span class="flex size-11 items-center justify-center rounded-btn bg-plum-600 text-white">
                <Icon name={icon} class="size-5" />
              </span>
              <h2 class="mt-4 text-base font-semibold text-ink">At a glance</h2>
              <ul class="mt-3 space-y-2.5">
                {highlights.map((h) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-plum-600" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/contact"
                class="btn btn-primary mt-6 w-full"
              >
                Discuss this service
                <Icon name="arrow-right" class="size-4" />
              </a>
            </Reveal>
          )
        }

        <div class="mt-6 rounded-card border border-brand-100 p-6 lg:mt-0">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink">Other services</h2>
          <ul class="mt-3 divide-y divide-brand-100">
            {
              others.map((s) => (
                <li>
                  <a
                    href={`/services/${s.id}`}
                    class="group flex items-center justify-between gap-3 py-2.5 text-sm text-muted transition-colors hover:text-brand-700"
                  >
                    <span class="flex items-center gap-2.5">
                      <Icon name={s.data.icon} class="size-4 text-plum-500" />
                      {s.data.title}
                    </span>
                    <Icon
                      name="chevron-right"
                      class="size-4 shrink-0 opacity-0 transition-opacity group-hover:opacity-100"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </aside>
  </div>

  {showcase === 'apps' && <AppShowcase />}
  {
    showcase === 'erp' && (
      <>
        <ModulesGrid />
        <DesktopSoftware />
      </>
    )
  }
  {showcase === 'iot' && solutions && solutions.length > 0 && <SolutionCards solutions={solutions} />}

  <CtaBand />
</BaseLayout>
