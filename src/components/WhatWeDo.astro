---
import { Heading } from '@alphalize/astro-marker';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import MarkedTitle from './MarkedTitle.astro';
import type { MarkerType } from './marks';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import appAlphalize from '@/assets/apps/369ai-alphalize.png';
import { site } from '@/config/site';
import { localeHref } from '@/i18n/paths';
import smartLocks from '@/assets/solutions/smart-locks.jpg';
import vending from '@/assets/solutions/vending.webp';
import robot from '@/assets/solutions/robot.webp';

/**
 * "What we do" as a pile of cards rather than a run of rows.
 *
 * Each card pins with `position: sticky`, and as the next one rides up over it
 * the covered card pivots slightly off-axis and dims. A rAF-throttled scroll
 * pass writes one number per card — `--p`, how far the next card has covered
 * it, 0 to 1 — and every bit of the motion is CSS reading that.
 *
 * The cards are deliberately not wrapped in <Reveal>: a transform on an
 * ancestor makes it the containing block for a sticky child, which would pin
 * the cards to the wrapper instead of the viewport.
 */
interface Row {
  kicker: string;
  /** Phrases to wrap in a marker stroke are marked inline — see marks.ts. */
  title: string;
  marker?: MarkerType;
  color?: string;
  body: string;
  points: string[];
  href: string;
  cta: string;
  external?: boolean;
  /**
   * One image, or several to rotate through. The devices row carries three
   * because the range is three distinct products — a single locker photo said
   * "we sell lockers" where the copy beside it promises vending and robotics
   * too.
   */
  image: ImageMetadata | { src: ImageMetadata; alt: string }[];
  imageAlt: string;
  fit: 'cover' | 'contain';
}

/** Alternating tilt: one direction throughout reads as mechanical. */
const FAN = ['-2.4deg', '2deg'];

const rows: Row[] = [
  {
    kicker: 'Odoo ERP',
    title: 'The back office, [[unified]]',
    body: 'Customised ERP that integrates finance, HR, supply chain and inventory into one source of truth, with approval workflows that run without someone chasing a spreadsheet.',
    points: [
      'Fifteen ready-made modules, from POS weighing scales to offline sync',
      'Role-based dashboards with the numbers each team needs',
      'Integrates with the accounting and payment systems you already run',
    ],
    href: '/services/erp-solutions',
    cta: 'Explore ERP solutions',
    image: appAlphalize,
    imageAlt: '369aiAlphalize — the Odoo back office in one app',
    fit: 'contain',
  },
  {
    kicker: 'Connected devices',
    title: 'Hardware that [[reports to your ERP]]',
    color: 'blue',
    body: 'The 369ai.Biz device range, wired into the same core as everything else — smart locks, unmanned retail and robotics, each one writing back to the ERP as it runs rather than at the end of the day.',
    points: [
      'Smart locks — centralised access control, live monitoring and digital authorisation per user and per location',
      'Smart vending machines — remote stock and performance monitoring, with touchless, card and QR payment',
      'Robotics — dispensing, warehousing and smart manufacturing, coordinated in real time',
    ],
    href: site.ai369Url,
    cta: 'See the range on 369ai.Biz',
    external: true,
    image: [
      { src: smartLocks, alt: 'Smart locker bank with centralised access control' },
      { src: vending, alt: 'Smart vending machine with touchless and QR payment' },
      { src: robot, alt: 'Warehouse robot for dispensing and smart manufacturing' },
    ],
    imageAlt: 'Smart locker bank with centralised access control',
    fit: 'cover',
  },
];
const { locale, t } = Astro.locals;
/**
 * Prefix an internal path with this page's locale. `row.href` is locale-free so
 * the table above does not have to know about locales; without this the link
 * went out unprefixed, which 404s in dev and 301s to English in production —
 * silently dropping a non-English reader out of their own language.
 */
const loc = (to: string) => localeHref(locale, to);
---

<Section variant="white" space="lg">
  <SectionHeading
    eyebrow={t('whatWeDo.eyebrow')}
    title={t('whatWeDo.title')}
    marker="highlight"
    color="yellow"
    lead={t('whatWeDo.lead')}
  />

  <div class="wwd-stack" data-wwd>
    {
      rows.map((row, i) => (
        <article class="wwd-card" data-card style={`--i:${i};--rot:${FAN[i % FAN.length]}`}>
          <div class="wwd-grid">
            <div>
              <p class="eyebrow">{row.kicker}</p>
              <Heading as="h3" size="md" class="mt-2">
                <MarkedTitle title={row.title} marker={row.marker} color={row.color} />
              </Heading>
              <p class="text-muted mt-4 leading-relaxed">{row.body}</p>

              <ul class="mt-5 space-y-2.5">
                {row.points.map((p) => (
                  <li class="text-muted flex gap-2.5 text-sm leading-relaxed">
                    <Icon name="check" class="text-plum-600 mt-0.5 size-4 shrink-0" />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>

              <a
                href={row.external ? row.href : loc(row.href)}
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener noreferrer' : undefined}
                class="wwd-link text-brand-700 hover:text-plum-600 mt-7 inline-flex items-center gap-1.5 text-sm font-semibold"
              >
                {row.cta}
                <Icon name="arrow-right" class="size-4" />
              </a>
            </div>

            {Array.isArray(row.image) ? (
              <div class="wwd-slider" data-wwd-slider>
                {/*
                  Every slide is in the DOM and the current one is chosen by an
                  index on the wrapper, so the swap cross-fades rather than
                  popping — and with JS off the first slide still shows, which
                  is what the single image used to be.
                */}
                <ul class="wwd-slides" data-slides>
                  {row.image.map((shot, s) => (
                    <li class="wwd-slide" data-slide aria-hidden={s > 0 ? 'true' : undefined}>
                      <Image
                        src={shot.src}
                        alt={shot.alt}
                        widths={[560, 1120]}
                        sizes="(min-width: 1024px) 520px, 92vw"
                        loading="lazy"
                        class="aspect-[4/3] w-full object-cover"
                      />
                    </li>
                  ))}
                </ul>

                <button
                  type="button"
                  class="wwd-arw wwd-prev"
                  data-prev
                  aria-label={t('whatWeDo.prev')}
                >
                  <Icon name="chevron-right" class="size-4" />
                </button>
                <button
                  type="button"
                  class="wwd-arw wwd-next"
                  data-next
                  aria-label={t('whatWeDo.next')}
                >
                  <Icon name="chevron-right" class="size-4" />
                </button>

                <div class="wwd-dots" role="tablist" aria-label={t('whatWeDo.slidesLabel')}>
                  {row.image.map((shot, s) => (
                    <button
                      type="button"
                      class="wwd-dot"
                      data-dot
                      role="tab"
                      aria-selected={s === 0 ? 'true' : 'false'}
                      aria-label={shot.alt}
                    />
                  ))}
                </div>
              </div>
            ) : (
              <div
                class:list={[
                  'rounded-card border-brand-100 overflow-hidden border',
                  row.fit === 'contain'
                    ? 'bg-surface flex h-64 items-center justify-center p-6'
                    : '',
                ]}
              >
                <Image
                  src={row.image}
                  alt={row.imageAlt}
                  widths={[560, 1120]}
                  sizes="(min-width: 1024px) 520px, 92vw"
                  loading="lazy"
                  class={
                    row.fit === 'cover'
                      ? 'aspect-[4/3] w-full object-cover'
                      : 'max-h-full w-auto object-contain'
                  }
                />
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .wwd-stack {
    /* Clearance for the sticky header, and the lip of each card left showing
       under the one above it. */
    --pin-top: 6rem;
    --pin-step: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3.5rem;
    /* Room for the last card to reach its pin point and settle. */
    padding-bottom: 30vh;
  }

  .wwd-card {
    position: sticky;
    top: calc(var(--pin-top) + var(--i) * var(--pin-step));
    padding: 2rem;
    /* Opaque on purpose: a translucent card lets the pile show through. */
    background: #fff;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
    transform-origin: center bottom;
    will-change: transform;
  }
  @media (width >= 64rem) {
    .wwd-card {
      padding: 2.75rem;
    }
  }

  /* Dimming the covered card is what sells the depth — the tilt on its own
     reads as a glitch rather than as a pile. */
  .wwd-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: var(--color-heading);
    opacity: calc(0.18 * var(--p, 0));
    transition: opacity 0.1s linear;
  }

  .wwd-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (width >= 64rem) {
    .wwd-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  /* ---------- device slider ---------- */
  .wwd-slider {
    position: relative;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .wwd-slides {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The first slide holds the box open; the rest stack on top of it, so the
     card never changes height as it rotates. */
  .wwd-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.55s var(--ease-out-soft);
  }
  .wwd-slide:first-child {
    position: relative;
  }
  .wwd-slide.is-on {
    opacity: 1;
  }
  /* No-JS and first paint: slide one is visible without waiting for script. */
  .wwd-slider:not(.js-wwd) .wwd-slide:first-child {
    opacity: 1;
  }

  .wwd-arw {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: -1rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.86);
    color: var(--color-heading);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.25s ease,
      background 0.25s ease;
  }
  .wwd-slider:hover .wwd-arw,
  .wwd-slider:focus-within .wwd-arw {
    opacity: 1;
  }
  .wwd-arw:hover {
    background: #fff;
  }
  .wwd-prev {
    inset-inline-start: 0.625rem;
    /* chevron-right is in Icon's MIRRORED set, so it already flips under RTL;
       this turns it into a "back" arrow in whichever direction that is. */
    rotate: 180deg;
  }
  .wwd-next {
    inset-inline-end: 0.625rem;
  }
  /* Touch has no hover, so the arrows would never appear. */
  @media (hover: none) {
    .wwd-arw {
      opacity: 1;
    }
  }

  .wwd-dots {
    position: absolute;
    inset-inline: 0;
    bottom: 0.625rem;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 0.375rem;
  }
  .wwd-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 0 0 1px rgb(4 30 57 / 0.18);
    cursor: pointer;
    transition:
      background 0.25s ease,
      width 0.25s ease;
  }
  .wwd-dot[aria-selected='true'] {
    width: 1.125rem;
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .wwd-slide,
    .wwd-arw,
    .wwd-dot {
      transition: none;
    }
  }

  .wwd-link :global(svg) {
    transition: transform 0.3s var(--ease-out-soft);
  }
  .wwd-link:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wwd-card {
      transform: rotate(calc(var(--rot, -2deg) * var(--p, 0))) scale(calc(1 - 0.035 * var(--p, 0)));
    }
    /* A narrow card rotating reads as broken rather than as a fan. */
    @media (width < 48rem) {
      .wwd-card {
        transform: scale(calc(1 - 0.03 * var(--p, 0)));
      }
    }
  }
</style>

<script>
  function mountWhatWeDo() {
    document.querySelectorAll<HTMLElement>('[data-wwd]').forEach((stack) => {
      const cards = [...stack.querySelectorAll<HTMLElement>('[data-card]')];
      if (!cards.length) return;

      let queued = false;

      // One pass per frame: for each card, how far the next one has covered it.
      const measure = () => {
        queued = false;
        cards.forEach((card, i) => {
          const next = cards[i + 1];
          if (!next) {
            card.style.setProperty('--p', '0');
            return;
          }
          const a = card.getBoundingClientRect();
          const b = next.getBoundingClientRect();
          // 0 while the next card's top sits at this card's bottom, 1 once it
          // has travelled the whole height of this one.
          const p = (a.bottom - b.top) / Math.max(a.height, 1);
          card.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(3));
        });
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(measure);
      };

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      measure();
    });
  }

  /**
   * The device slider on the connected-hardware card.
   *
   * Rotates on its own so all three products are seen without asking for a
   * click, but the moment someone uses an arrow or a dot it stops for good —
   * taking control back off a visitor who has just taken it is hostile. Hover
   * and focus pause it for the same reason: a slide that moves out from under
   * a pointer mid-read is how these get a bad name.
   */
  const ROTATE_MS = 5000;

  function mountWwdSliders() {
    document.querySelectorAll<HTMLElement>('[data-wwd-slider]').forEach((slider) => {
      const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...slider.querySelectorAll<HTMLElement>('[data-dot]')];
      if (slides.length < 2) return;

      // Hands the slide state over from CSS, so slide one is visible from the
      // first paint and stays visible if this script never runs.
      slider.classList.add('js-wwd');

      let at = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      const still = matchMedia('(prefers-reduced-motion: reduce)');

      const show = (next: number) => {
        at = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-on', i === at);
          // Only the visible slide is exposed; the others are decoration until
          // they come round.
          if (i === at) slide.removeAttribute('aria-hidden');
          else slide.setAttribute('aria-hidden', 'true');
        });
        dots.forEach((dot, i) => dot.setAttribute('aria-selected', String(i === at)));
      };

      const stop = () => {
        clearInterval(timer);
        timer = undefined;
      };
      const start = () => {
        if (timer || still.matches) return;
        timer = setInterval(() => show(at + 1), ROTATE_MS);
      };
      /** Manual control wins permanently — see the note above. */
      const take = (next: number) => {
        stop();
        slider.dataset.manual = '';
        show(next);
      };

      slider.querySelector('[data-prev]')?.addEventListener('click', () => take(at - 1));
      slider.querySelector('[data-next]')?.addEventListener('click', () => take(at + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => take(i)));

      slider.addEventListener('pointerenter', stop);
      slider.addEventListener('focusin', stop);
      const resume = () => {
        if (!('manual' in slider.dataset)) start();
      };
      slider.addEventListener('pointerleave', resume);
      slider.addEventListener('focusout', (e) => {
        if (!slider.contains(e.relatedTarget as Node)) resume();
      });

      show(0);
      start();
      // Never leave an interval ticking against a page that has been swapped.
      document.addEventListener('astro:before-swap', stop, { once: true });
    });
  }

  document.addEventListener('astro:page-load', mountWhatWeDo);
  document.addEventListener('astro:page-load', mountWwdSliders);
</script>
