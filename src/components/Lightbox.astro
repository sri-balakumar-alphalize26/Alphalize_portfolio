---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

/**
 * A photo that opens full size.
 *
 * Native <dialog> + showModal(), which is why this is short: the focus trap,
 * Escape, the inert background and returning focus to the trigger are all
 * browser behaviour. The 369 Lightbox hand-rolls each of those.
 *
 * The tile keeps the photo's real aspect ratio so nothing is cropped, and the
 * dialog shows the same optimised asset at a larger width — a few hundred KB
 * either way, so there is no separate "large" variant to keep in step.
 *
 * No `style` prop on purpose: pass positioning or animation delay on a wrapper.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio for the tile, e.g. '800 / 1200'. */
  ratio: string;
  /** Sweep a light across the tile — for a single object on a plain ground. */
  shine?: boolean;
  openLabel?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio,
  shine = false,
  openLabel = 'View full size',
  class: className,
} = Astro.props;

// Unique per instance so several lightboxes can sit on one page.
const id = `lb-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['lb', className]} style={`aspect-ratio:${ratio}`}>
  <button type="button" class="lb-open" data-lb-open={id} aria-label={`${openLabel}: ${alt}`}>
    <Image src={src} alt={alt} widths={[400, 800]} sizes="(min-width: 640px) 45vw, 100vw" />
    <span class="lb-hint" aria-hidden="true">
      <Icon name="camera" />
    </span>
  </button>
  {shine && <span class="lb-shine" aria-hidden="true" />}
</div>

<dialog class="lb-dlg" id={id}>
  <form method="dialog" class="lb-close-form">
    <button class="lb-close" aria-label="Close">
      <Icon name="close" />
    </button>
  </form>
  <Image src={src} alt={alt} widths={[900, 1600]} sizes="92vw" loading="lazy" />
</dialog>

<script>
  function initLightbox() {
    document.querySelectorAll<HTMLButtonElement>('[data-lb-open]').forEach((btn) => {
      if (btn.dataset.lbWired) return;
      btn.dataset.lbWired = '1';
      const dlg = document.getElementById(btn.dataset.lbOpen!) as HTMLDialogElement | null;
      if (!dlg) return;

      btn.addEventListener('click', () => dlg.showModal());

      // Clicking the backdrop closes it. The dialog fills the viewport, so the
      // test is whether the point landed outside the picture rather than
      // outside the dialog.
      dlg.addEventListener('click', (e) => {
        const img = dlg.querySelector('img');
        if (!img) return;
        const r = img.getBoundingClientRect();
        const inside =
          e.clientX >= r.left &&
          e.clientX <= r.right &&
          e.clientY >= r.top &&
          e.clientY <= r.bottom;
        if (!inside) dlg.close();
      });
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
  if (document.readyState !== 'loading') initLightbox();
  else document.addEventListener('DOMContentLoaded', initLightbox, { once: true });
</script>

<style>
  .lb {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .lb-open {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .lb-open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-soft);
  }
  .lb-open:hover :global(img) {
    transform: scale(1.03);
  }
  .lb-open:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: -2px;
  }

  /* The affordance: without it a picture that opens looks like one that does not. */
  .lb-hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(4 30 57 / 0.55);
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.28s ease,
      transform 0.28s var(--ease-out-soft);
  }
  .lb-hint :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }
  .lb-open:hover .lb-hint,
  .lb-open:focus-visible .lb-hint {
    opacity: 1;
    transform: none;
  }

  .lb-shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -40%;
    width: 26%;
    pointer-events: none;
    background: linear-gradient(105deg, transparent, rgb(255 255 255 / 0.5), transparent);
    transform: skewX(-18deg);
    opacity: 0;
  }
  .lb:hover .lb-shine {
    animation: lb-sweep 0.9s ease-out;
  }
  @keyframes lb-sweep {
    from {
      opacity: 1;
      left: -40%;
    }
    to {
      opacity: 1;
      left: 120%;
    }
  }

  /* --- the dialog --- */
  .lb-dlg {
    width: 92vw;
    max-width: 72rem;
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .lb-dlg::backdrop {
    background: rgb(4 30 57 / 0.82);
    backdrop-filter: blur(4px);
  }
  .lb-dlg :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 92vh;
    margin: 0 auto;
    border-radius: var(--radius-card);
  }
  .lb-close-form {
    position: absolute;
    top: -2.75rem;
    right: 0;
  }
  .lb-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    cursor: pointer;
    transition: background 0.25s ease;
  }
  .lb-close:hover {
    background: rgb(255 255 255 / 0.28);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lb-dlg[open] {
      animation: lb-in 0.28s var(--ease-out-soft);
    }
    @keyframes lb-in {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-open :global(img),
    .lb-hint {
      transition: none;
    }
    .lb-open:hover :global(img) {
      transform: none;
    }
    .lb:hover .lb-shine {
      animation: none;
    }
  }
</style>
