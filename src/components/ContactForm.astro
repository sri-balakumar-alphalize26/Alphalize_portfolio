---
import Field from './Field.astro';
import Icon from './Icon.astro';
import Turnstile from './Turnstile.astro';
---

<form
  action="/api/contact"
  method="post"
  data-enhance
  class="rounded-card border border-brand-100 bg-white p-6 sm:p-8"
>
  <h2 class="text-xl font-semibold text-ink">Get in touch</h2>
  <p class="mt-1.5 text-sm text-muted">
    Tell us what you are trying to change. We reply to every enquiry.
  </p>

  <!-- Live region so screen readers announce the result of a submission. -->
  <div class="mt-5 empty:mt-0" role="status" aria-live="polite">
    <p data-form-banner class="hidden"></p>
  </div>

  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <Field name="name" label="Name" required autocomplete="name" placeholder="Your full name" />
    <Field
      name="email"
      label="Email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@company.com"
    />
    <Field
      name="phone"
      label="Phone"
      type="tel"
      required
      autocomplete="tel"
      placeholder="+91 00000 00000"
    />
    <Field name="subject" label="Subject" required placeholder="What is this about?" />
    <Field
      name="message"
      label="Message"
      type="textarea"
      required
      class="sm:col-span-2"
      placeholder="A few lines on your current setup and what you would like to improve."
    />
  </div>

  {/* No wrapper margin: interaction-only means this is usually zero-height,
      and a fixed margin would leave a gap. When a challenge does appear, the
      submit row below supplies the separation. */}
  <Turnstile />

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="btn btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
    >
      <span data-submit-label>Send message</span>
      <Icon name="arrow-right" class="size-4" />
    </button>

    {/* Opens WhatsApp with the entered details already written. Not a submit:
        it never posts, so the enquiry only reaches us if they press send there.
        WhatsAppManage wires the click and resolves the number. */}
    <button type="button" data-wa-send class="btn btn-outline w-full sm:w-auto">
      Send on WhatsApp
      <Icon name="whatsapp" class="size-4" />
    </button>
  </div>

  <p class="mt-3 text-xs text-muted">
    Fill this in and "Send on WhatsApp" opens a chat with your details already written — press send
    there.
  </p>

  <p class="mt-3 text-xs text-muted">
    We use your details only to respond to this enquiry. See our
    <a href="/legal/privacy-policy" class="text-brand-700 underline">privacy policy</a>.
  </p>
</form>

<script>
  import { initForms } from './form-enhance';
  document.addEventListener('astro:page-load', initForms);
</script>
