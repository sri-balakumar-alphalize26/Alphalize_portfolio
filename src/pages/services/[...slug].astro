---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import AboutAnim from '@/components/AboutAnim.astro';
import AppShowcase from '@/components/AppShowcase.astro';
import CtaBand from '@/components/CtaBand.astro';
import DesktopSoftware from '@/components/DesktopSoftware.astro';
import ModulesGrid from '@/components/ModulesGrid.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceSidebar from '@/components/ServiceSidebar.astro';
import SolutionCards from '@/components/SolutionCards.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const { title, titleMarked, summary, seoDescription, icon, highlights, showcase, solutions } =
  service.data;
const { Content } = await render(service);

// The mobile page lists the apps as SoftwareApplication entries for search engines.
const apps =
  showcase === 'apps'
    ? (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order)
    : [];

// Sibling services for the "explore more" rail.
const others = (await getCollection('services'))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: title,
    description: seoDescription ?? summary,
    url: `${site.url}/services/${service.id}`,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: ['IN'],
  },
];

if (apps.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Alphalize mobile apps',
    itemListElement: apps.map((app, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: app.data.title,
        description: app.data.tagline,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Android',
        author: { '@id': `${site.url}/#organization` },
      },
    })),
  });
}
---

<BaseLayout title={title} description={seoDescription ?? summary} ogType="article" jsonLd={jsonLd}>
  <AboutAnim />

  <PageHero
    anim
    eyebrow="Service"
    title={titleMarked}
    lead={summary}
    crumbs={[{ label: 'Services', href: '/services' }]}
  />

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-20">
    {
      /* Body. One [data-ab] unit with an auto-assigned stagger: the blocks come
        from rendered markdown, so there is no template to annotate them in. */
    }
    <article
      class="prose-content lg:col-span-8"
      data-ab
      data-ab-cascade
      data-base="0"
      data-step="90"
    >
      <Content />
    </article>

    <aside class="lg:col-span-4">
      <ServiceSidebar icon={icon} highlights={highlights} others={others} />
    </aside>
  </div>

  {showcase === 'apps' && <AppShowcase />}
  {
    showcase === 'erp' && (
      <>
        <ModulesGrid />
        <DesktopSoftware />
      </>
    )
  }
  {
    showcase === 'iot' && solutions && solutions.length > 0 && (
      <SolutionCards solutions={solutions} />
    )
  }

  <CtaBand />
</BaseLayout>
