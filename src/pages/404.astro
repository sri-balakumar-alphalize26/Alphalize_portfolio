---
import { getLocalized } from '@/i18n/collections';
import { localeHref } from '@/i18n/paths';
import { defaultLocale } from '@/i18n/locales';
import { getTranslations } from '@/i18n/messages';
import { Heading } from '@alphalize/astro-marker';
import { getCollection } from 'astro:content';
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * Falls back rather than destructuring straight from locals.
 *
 * This is the page that renders when nothing else matched, which is exactly
 * when the request is least normal — an unmatched path, no [locale] param, and
 * in some dev and adapter paths no middleware run at all. Everywhere else it is
 * right to assume `t` exists, because a missing one is a bug worth surfacing.
 * Here it is not: a 404 that throws turns a wrong URL into a 500, which is a
 * worse answer to the same mistake.
 */
const locale = Astro.locals.locale ?? defaultLocale;
const t = Astro.locals.t ?? (await getTranslations(locale));

/** Prefix an internal path with this page's locale. */
const loc = (to: string) => localeHref(locale, to);

const services = await getLocalized('services', locale);
---

<BaseLayout title={t('notFound.metaTitle')} description={t('notFound.metaDescription')} noindex>
  <section class="container-page py-24 text-center lg:py-32">
    <p class="text-plum-200 text-7xl font-semibold lg:text-8xl">404</p>
    <Heading as="h1" size="lg" align="center" class="mt-4">{t('notFound.heading')}</Heading>
    <p class="text-muted mx-auto mt-4 max-w-xl text-base leading-relaxed">
      {t('notFound.body')}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={loc('/')} class="btn btn-primary">{t('notFound.backHome')}</a>
      <a href={loc('/contact')} class="btn btn-outline text-brand-700">{t('notFound.contactUs')}</a>
    </div>

    <div class="mx-auto mt-14 max-w-2xl text-left">
      <h2 class="text-muted text-center text-sm font-semibold tracking-wider uppercase">
        {t('notFound.jumpToService')}
      </h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          services.map((s) => (
            <li>
              <a
                href={loc(`/services/${s.slug}`)}
                class="border-brand-100 text-muted hover:border-brand-200 hover:bg-brand-50/50 hover:text-brand-700 flex items-center gap-2.5 rounded-lg border px-4 py-3 text-sm transition-colors"
              >
                <Icon name={s.entry.data.icon} class="text-brand-500 size-4 shrink-0" />
                {s.entry.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
