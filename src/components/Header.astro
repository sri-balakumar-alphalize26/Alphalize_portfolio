---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '@/assets/brand/logo.png';
import { contact, nav } from '@/config/site';
import Icon from './Icon.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

// Derived from the collection rather than a flag on `nav`, so the badge goes
// away on its own once every role is closed.
const openRoles = (await getCollection('jobs', ({ data }) => data.open)).length;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<!-- Utility bar: contact details that were buried in the old off-canvas panel. -->
<span id="hdr-top" aria-hidden="true"></span>
<div class="hidden bg-brand-900 text-brand-200 lg:block">
  <div class="container-page flex h-9 items-center justify-between text-xs">
    <p>ERP, business intelligence and custom software — Kollam, Kerala</p>
    <div class="flex items-center gap-6">
      <a class="flex items-center gap-1.5 hover:text-white" href={contact.phoneHref} data-contact-tel>
        <Icon name="phone" class="size-3.5" />
        <span data-contact-phone>{contact.phone}</span>
      </a>
      <a
        class="flex items-center gap-1.5 hover:text-white"
        href={`mailto:${contact.emailUser}@${contact.emailDomain}`}
        data-contact-mailto
      >
        <Icon name="mail" class="size-3.5" />
        <span data-contact-email>{contact.emailUser}@{contact.emailDomain}</span>
      </a>
    </div>
  </div>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-brand-100/70 bg-white/85 backdrop-blur-md transition-shadow data-[stuck]:shadow-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="shrink-0" aria-label="Alphalize — home">
      <Image
        src={logo}
        alt="Alphalize"
        widths={[180, 360]}
        sizes="180px"
        class="h-8 w-auto lg:h-9"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) =>
            item.hasChildren ? (
              <li class="nav-drop group relative" data-drop>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-1 rounded-btn px-3 py-2 text-sm font-medium transition-colors',
                    isActive(item.href)
                      ? 'text-plum-600'
                      : 'text-heading hover:text-plum-600',
                  ]}
                >
                  {item.label}
                  <Icon
                    name="chevron-down"
                    class="size-4 transition-transform group-hover:rotate-180"
                  />
                </a>
                <!--
                  CSS-only dropdown: hover opens it, and focus-within keeps it
                  open for keyboard users tabbing through the links.
                -->
                <div
                  class="nav-drop-menu invisible absolute left-1/2 top-full w-72 -translate-x-1/2 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
                >
                  <ul
                    class="overflow-hidden rounded-card border border-brand-100 bg-white p-2 shadow-lift"
                  >
                    {
                      services.map((s, i) => (
                        <li class="nav-drop-item" style={`--k:${i}`}>
                          <a
                            href={`/services/${s.id}`}
                            class="flex items-start gap-3 rounded-btn px-3 py-2.5 transition-colors hover:bg-plum-50"
                          >
                            <Icon name={s.data.icon} class="mt-0.5 size-4 text-plum-600" />
                            <span class="text-sm font-medium text-ink">{s.data.title}</span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-btn px-3 py-2 text-sm font-medium transition-colors',
                    isActive(item.href) ? 'text-plum-600' : 'text-heading hover:text-plum-600',
                  ]}
                >
                  {item.label}
                  {item.href === '/careers' && openRoles > 0 && (
                    <span class="hiring-badge">
                      Hiring<span aria-hidden="true">&nbsp;!!</span>
                      <span class="sr-only">
                        , {openRoles} open {openRoles === 1 ? 'role' : 'roles'}
                      </span>
                    </span>
                  )}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact"
        class="btn btn-primary hidden sm:inline-flex"
      >
        Get a consultation
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="-mr-2 inline-flex size-11 items-center justify-center rounded-md text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" hidden class="border-t border-brand-100 bg-white lg:hidden">
    <nav class="container-page py-4" aria-label="Mobile">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-btn px-3 py-3 text-base font-medium',
                  isActive(item.href) ? 'bg-plum-50 text-plum-600' : 'text-heading',
                ]}
              >
                {item.label}
                {item.href === '/careers' && openRoles > 0 && (
                  <span class="hiring-badge">
                    Hiring<span aria-hidden="true">&nbsp;!!</span>
                    <span class="sr-only">
                      , {openRoles} open {openRoles === 1 ? 'role' : 'roles'}
                    </span>
                  </span>
                )}
              </a>
              {item.hasChildren && (
                <ul class="mb-2 ml-3 space-y-0.5 border-l border-brand-100 pl-3">
                  {services.map((s) => (
                    <li>
                      <a
                        href={`/services/${s.id}`}
                        class="block rounded-md px-3 py-2 text-sm text-muted"
                      >
                        {s.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <a
        href="/contact"
        class="btn btn-primary mt-3 w-full"
      >
        Get a consultation
      </a>
      <div class="mt-4 space-y-2 border-t border-brand-100 pt-4 text-sm text-muted">
        <a class="flex items-center gap-2" href={contact.phoneHref} data-contact-tel>
          <Icon name="phone" class="size-4 text-brand-600" />
          <span data-contact-phone>{contact.phone}</span>
        </a>
        <a
          class="flex items-center gap-2"
          href={`mailto:${contact.emailUser}@${contact.emailDomain}`}
          data-contact-mailto
        >
          <Icon name="mail" class="size-4 text-brand-600" />
          <span data-contact-email>{contact.emailUser}@{contact.emailDomain}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile drawer + sticky-shadow. Re-bound on every view transition via
  // astro:page-load, which also fires on the initial load.
  function initHeader() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const header = document.getElementById('site-header');
    if (!toggle || !menu || !header) return;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      const label = toggle.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    // Close on Escape so keyboard users are never trapped in the drawer.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Drop the drawer if the viewport grows past the lg breakpoint.
    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });

    // Compact the header once the page has scrolled past the top. A sentinel
    // above the header costs nothing per frame, unlike a scroll listener.
    const sentinel = document.getElementById('hdr-top');
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => header.toggleAttribute('data-stuck', !entry.isIntersecting),
        { threshold: 0 }
      ).observe(sentinel);
    }

    // Services dropdown. The CSS-only hover is the no-JS baseline; `js-nav`
    // hands control over to this so hover-intent and Escape can apply. Services
    // stays a real link either way.
    const drop = header.querySelector<HTMLElement>('[data-drop]');
    const trigger = drop?.querySelector<HTMLAnchorElement>('a');
    if (drop && trigger) {
      header.classList.add('js-nav');
      let closeTimer: ReturnType<typeof setTimeout>;
      const setOpenDrop = (open: boolean) => {
        clearTimeout(closeTimer);
        drop.classList.toggle('open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };

      drop.addEventListener('pointerenter', () => setOpenDrop(true));
      // A short delay so the menu survives the pointer clipping a corner.
      drop.addEventListener('pointerleave', () => {
        closeTimer = setTimeout(() => setOpenDrop(false), 160);
      });
      drop.addEventListener('focusin', () => setOpenDrop(true));
      drop.addEventListener('focusout', (e) => {
        if (!drop.contains(e.relatedTarget as Node)) setOpenDrop(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drop.classList.contains('open')) {
          setOpenDrop(false);
          trigger.focus();
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  /* --- "Hiring !!" badge. Derived from the jobs collection, so it clears
         itself once every role is closed. --- */
  .hiring-badge {
    display: inline-flex;
    align-items: center;
    margin-left: 0.4rem;
    padding: 0.1rem 0.4rem;
    border-radius: 99px;
    background: var(--color-plum-600);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hiring-badge {
      animation: hdr-pulse 2.4s var(--ease-out-soft) infinite;
    }
  }
  @keyframes hdr-pulse {
    0%,
    70%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-plum-600) 55%, transparent);
    }
    35% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-plum-600) 0%, transparent);
    }
  }

  /* The zip collapses its utility bar on scroll, but its bar lives inside the
     sticky header. Ours sits above it and scrolls away on its own, so there is
     nothing to collapse — the sentinel is only driving the shadow. */

  /* --- Dropdown: JS takes over from the CSS-only hover once `js-nav` is set,
         so hover-intent and Escape apply only where they can work. The scoped
         attribute selector gives these the specificity to win over Tailwind's
         group-hover utilities. --- */
  :global(.js-nav) .nav-drop-menu {
    visibility: hidden;
    opacity: 0;
  }
  :global(.js-nav) .nav-drop.open .nav-drop-menu {
    visibility: visible;
    opacity: 1;
  }

  /* Items cascade in as the panel opens. */
  @media (prefers-reduced-motion: no-preference) {
    .nav-drop-item {
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 0.28s ease,
        transform 0.28s var(--ease-out-soft);
    }
    .nav-drop:hover .nav-drop-item,
    .nav-drop:focus-within .nav-drop-item,
    .nav-drop.open .nav-drop-item {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--k, 0) * 35ms);
    }
  }
</style>
